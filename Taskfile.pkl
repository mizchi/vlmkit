/// vlmkit task definitions for pkfire.
///
/// Replaces the previous bash justfile. Each task is a typed `Task`
/// with declared inputs so pkfire can
/// skip re-runs when sources haven't changed.
///
/// Usage:
///   pkf list                  # show all tasks
///   pkf run vlmkit-test          # run a task
///   pkf run smoke-all         # full smoke
///   pkf run --watch vlmkit-test  # re-run on src changes
///
/// Cache directory: $PKFIRE_CACHE_DIR or ~/.cache/pkfire.
amends "package://pkg.pkl-lang.org/github.com/mizchi/pkfire/pkfire@0.10.0#/Taskfile.pkl"

// ---- Core ----

local vlmkitTest = new Task {
  name = "vlmkit-test"
  cmd = "node --test src/**/*.test.ts"
  inputs { "src/**/*.ts" }
}

local bench = new Task {
  name = "bench"
  cmd = "node src/experiments/benchmark/benchmark.ts"
  inputs { "src/experiments/benchmark/benchmark.ts"; "packages/vlmkit-core/src/heatmap.ts" }
}

local introspectBench = new Task {
  name = "introspect-bench"
  acceptsArgs = true
  cmd = "node src/experiments/benchmark/introspect-bench.ts"
  inputs {
    "src/experiments/benchmark/introspect-bench.ts"
    "packages/vlmkit-markup/src/contract/introspect-contract.ts"
    "packages/vlmkit-markup/src/component/semantic-drilldown.ts"
    "design-runs/patterns-20260520/**/current.html"
  }
}

// ---- Demos ----

local vlmkitDemo = new Task {
  name = "vlmkit-demo"
  cmd = "node src/demo/demo.ts"
  inputs { "src/demo/demo.ts" }
}
local vlmkitDemoFix = new Task {
  name = "vlmkit-demo-fix"
  cmd = "node src/demo/demo-fix-loop.ts"
  inputs { "src/demo/demo-fix-loop.ts" }
}
local vlmkitDemoMulti = new Task {
  name = "vlmkit-demo-multi"
  cmd = "node src/demo/demo-scenarios.ts"
  inputs { "src/demo/demo-scenarios.ts" }
}
local vlmkitDemoMultistep = new Task {
  name = "vlmkit-demo-multistep"
  cmd = "node src/demo/demo-multistep.ts"
  inputs { "src/demo/demo-multistep.ts" }
}

// ---- CSS challenge bench ----

local cssBench = new Task {
  name = "css-bench"
  acceptsArgs = true
  cmd = "NO_IMAGES=1 node src/experiments/css-challenge/css-challenge-bench.ts"
  inputs { "src/experiments/css-challenge/css-challenge*.ts"; "fixtures/css-challenge/**" }
}
local cssBenchSelector = new Task {
  name = "css-bench-selector"
  acceptsArgs = true
  cmd = "NO_IMAGES=1 node src/experiments/css-challenge/css-challenge-bench.ts --mode selector"
  inputs { "src/experiments/css-challenge/css-challenge*.ts"; "fixtures/css-challenge/**" }
}
local cssBenchAll = new Task {
  name = "css-bench-all"
  params {
    new { name = "trials"; type = "int"; default = "30" }
  }
  cmd = "NO_IMAGES=1 node src/experiments/css-challenge/css-challenge-bench.ts --trials $TRIALS --fixture all"
  inputs { "src/experiments/css-challenge/css-challenge*.ts"; "fixtures/css-challenge/**" }
}
local cssBenchCrater = new Task {
  name = "css-bench-crater"
  acceptsArgs = true
  cmd = "NO_IMAGES=1 node src/experiments/css-challenge/css-challenge-bench.ts --backend crater"
  inputs { "src/experiments/css-challenge/css-challenge*.ts"; "fixtures/css-challenge/**" }
}
local cssBenchPrescanner = new Task {
  name = "css-bench-prescanner"
  acceptsArgs = true
  cmd = "NO_IMAGES=1 node src/experiments/css-challenge/css-challenge-bench.ts --backend prescanner"
  inputs { "src/experiments/css-challenge/css-challenge*.ts"; "fixtures/css-challenge/**" }
}
local cssReport = new Task {
  name = "css-report"
  cmd = "node src/experiments/detection/detection-report.ts"
  inputs { "src/experiments/detection/detection-report.ts"; "src/experiments/detection/detection-db.ts" }
}

// ---- CSS bench approve / migration ----

local benchApprove = new Task {
  name = "bench-approve"
  cmd = "node src/cli/workflow/bench-approve.ts"
  inputs { "src/cli/workflow/bench-approve.ts"; "src/vrt/snapshot/approval*.ts" }
}

local migrationCompare = new Task {
  name = "migration-compare"
  cmd = "node src/experiments/migration/migration-compare.ts"
  inputs { "src/experiments/migration/migration-compare.ts"; "src/experiments/migration/migration-*.ts" }
}

local migrationFixLoop = new Task {
  name = "migration-fix-loop"
  cmd = "node src/experiments/migration/migration-fix-loop.ts"
  inputs { "src/experiments/migration/migration-fix-loop*.ts" }
}

local migrationReset = new Task {
  name = "migration-reset"
  cmd = #"""
    node src/experiments/migration/migration-compare.ts \
      --dir fixtures/migration/reset-css \
      --baseline normalize.html \
      --variants modern-normalize.html destyle.html no-reset.html
  """#
  inputs { "src/experiments/migration/migration-compare.ts"; "fixtures/migration/reset-css/**" }
}

local migrationTailwind = new Task {
  name = "migration-tailwind"
  cmd = #"""
    node src/experiments/migration/migration-compare.ts \
      fixtures/migration/tailwind-to-vanilla/before.html \
      fixtures/migration/tailwind-to-vanilla/after.html
  """#
  inputs { "src/experiments/migration/migration-compare.ts"; "fixtures/migration/tailwind-to-vanilla/**" }
}

local migrationShadcn = new Task {
  name = "migration-shadcn"
  cmd = #"""
    node src/experiments/migration/migration-compare.ts \
      --dir fixtures/migration/shadcn-to-luna \
      --baseline before.html --variants after.html
  """#
  inputs { "src/experiments/migration/migration-compare.ts"; "fixtures/migration/shadcn-to-luna/**" }
}

local migrationSubagentPrepare = new Task {
  name = "migration-subagent-prepare"
  acceptsArgs = true
  cmd = "node src/experiments/migration/migration-subagent.ts prepare"
  inputs { "src/experiments/migration/migration-subagent.ts"; "src/experiments/migration/migration-fix-loop-core.ts" }
}

local migrationSubagentEvaluate = new Task {
  name = "migration-subagent-evaluate"
  acceptsArgs = true
  cmd = "node src/experiments/migration/migration-subagent.ts evaluate"
  inputs { "src/experiments/migration/migration-subagent.ts" }
}

local migrationBlindList = new Task {
  name = "migration-blind-list"
  cmd = "node src/experiments/migration/migration-blind.ts fixtures/migration/blind-scenarios.json list"
  inputs { "src/experiments/migration/migration-blind.ts"; "fixtures/migration/blind-scenarios.json" }
}

local migrationBlindShow = new Task {
  name = "migration-blind-show"
  params {
    new { name = "scenario"; type = "string" }
  }
  cmd = "node src/experiments/migration/migration-blind.ts fixtures/migration/blind-scenarios.json show $SCENARIO"
  inputs { "src/experiments/migration/migration-blind.ts"; "fixtures/migration/blind-scenarios.json" }
}

local migrationBlindPrepare = new Task {
  name = "migration-blind-prepare"
  acceptsArgs = true
  params {
    new { name = "scenario"; type = "string" }
  }
  cmd = "node src/experiments/migration/migration-blind.ts fixtures/migration/blind-scenarios.json prepare $SCENARIO"
  inputs { "src/experiments/migration/migration-blind.ts"; "fixtures/migration/blind-scenarios.json"; "fixtures/migration/**" }
}

local migrationBlindSolo = new Task {
  name = "migration-blind-solo"
  acceptsArgs = true
  params {
    new { name = "scenario"; type = "string" }
  }
  cmd = "node src/experiments/migration/migration-blind.ts fixtures/migration/blind-scenarios.json solo $SCENARIO"
  inputs { "src/experiments/migration/migration-blind.ts"; "fixtures/migration/blind-scenarios.json"; "fixtures/migration/**" }
}

local migrationBlindEvaluate = new Task {
  name = "migration-blind-evaluate"
  acceptsArgs = true
  params {
    new { name = "scenario"; type = "string" }
  }
  cmd = "node src/experiments/migration/migration-blind.ts fixtures/migration/blind-scenarios.json evaluate $SCENARIO"
  inputs { "src/experiments/migration/migration-blind.ts"; "fixtures/migration/blind-scenarios.json" }
}

local flakerVrtAdapt = new Task {
  name = "flaker-vrt-adapt"
  cmd = "node src/experiments/flaker/flaker-vrt-report-adapter.ts"
  inputs { "src/experiments/flaker/flaker-vrt-report-adapter.ts" }
}

// ---- Fix / VLM ----

local fixLoop = new Task {
  name = "fix-loop"
  acceptsArgs = true
  cmd = "node src/experiments/css-challenge/fix-loop.ts"
  inputs { "src/experiments/css-challenge/fix-loop.ts"; "packages/vlmkit-ai/src/vlm-client.ts"; "packages/vlmkit-ai/src/llm-client.ts" }
}

local vlmBench = new Task {
  name = "vlm-bench"
  acceptsArgs = true
  cmd = "node src/experiments/benchmark/vlm-bench.ts"
  inputs { "src/experiments/benchmark/vlm-bench.ts" }
}

// ---- API / smoke / snapshot ----

local apiServer = new Task {
  name = "api-server"
  cmd = "node src/api/api-server.ts"
  inputs { "src/api/api-server.ts"; "src/api/api-types.ts" }
}

local smokeTest = new Task {
  name = "smoke-test"
  cmd = "node packages/vlmkit-markup/src/inspect/smoke-runner.ts"
  inputs { "packages/vlmkit-markup/src/inspect/smoke-runner.ts" }
}

local snapshot = new Task {
  name = "snapshot"
  cmd = "node --experimental-strip-types src/cli/vlmkit.ts snapshot"
  inputs { "src/cli/vlmkit.ts"; "src/cli/commands/snapshot.ts"; "src/vrt/snapshot/**.ts" }
}

// ---- Dogfood ----

local dogfoodLuna = new Task {
  name = "dogfood-luna"
  cmd = #"""
    node --experimental-strip-types src/cli/vlmkit.ts snapshot \
      http://localhost:4200/src/examples/todomvc/ \
      http://localhost:4200/src/examples/spa/ \
      http://localhost:4200/src/examples/wc/ \
      http://localhost:4200/src/examples/apg-playground/ \
      http://localhost:4200/src/examples/browser_router/ \
      http://localhost:4200/src/examples/css_split_test/ \
      --output test-results/snapshots/luna
  """#
}

local dogfoodSol = new Task {
  name = "dogfood-sol"
  cmd = #"""
    node --experimental-strip-types src/cli/vlmkit.ts snapshot \
      http://localhost:3000/ \
      http://localhost:3000/luna/ \
      http://localhost:3000/sol/ \
      http://localhost:3000/benchmark/ \
      --output test-results/snapshots/sol \
      --mask ".marquee-container,.hero-badge"
  """#
}

local falsePositive = new Task {
  name = "false-positive"
  params {
    new { name = "url"; type = "string" }
  }
  cmd = #"""
    node src/experiments/migration/migration-compare.ts \
      --url $URL --current-url $URL \
      --output-dir test-results/false-positive --no-paint-tree
  """#
}

// ---- Playwright ----
//
// `vrt` / `vrt-update` (`playwright test`) are gone with `e2e/vlmkit-capture.spec.ts` and the
// root `playwright.config.ts`. Route capture is `vlmkit workflow init` / `workflow capture`,
// which run in-process now; the only remaining playwright configs belong to fixtures
// (`packages/vlmkit-heal/fixtures/`) and to user projects that vlmkit generates tests for.

// ---- Markup-assistance suite (new this PR) ----
//
// The 22 markup-assistance gates the smoke drives, under `vlmkit <group> <leaf>`.
// `smoke-all` runs the existing bash script (single source of truth
// for fixture wiring); individual CLI verifies are covered by
// pkspec/Test.pkl so we don't duplicate them here.

local smokeAll = new Task {
  name = "smoke-all"
  cmd = "bash scripts/smoke-all-clis.sh"
  inputs {
    "scripts/smoke-all-clis.sh"
    "src/**/*.ts"
    "fixtures/**/*.html"
    "fixtures/**/*.png"
    "fixtures/**/*.json"
  }
}

local vlmkitHelp = new Task {
  name = "vlmkit-help"
  cmd = "node --experimental-strip-types src/cli/vlmkit.ts help"
  inputs { "src/cli/vlmkit.ts"; "src/cli/cli.ts" }
}

// ---- Spec gates (pkspec) ----

local specCheck = new Task {
  name = "spec-check"
  cmd = "pkspec check Spec.pkl Test.pkl"
  inputs { "Spec.pkl"; "Test.pkl"; "pkspec/**" }
}

local specLint = new Task {
  name = "spec-lint"
  // Mirror of the CI invocation in .github/workflows/spec-gate.yml.
  // deprecated-without-replacedBy is suppressed because the matrix
  // backfill (#10) deliberately marks out-of-scope rows terminal —
  // no successor scenario exists for them.
  cmd = "pkspec lint --lint-disable lint.deprecated-without-replacedBy Spec.pkl Test.pkl"
  inputs { "Spec.pkl"; "Test.pkl"; "pkspec/**" }
}

local specRender = new Task {
  name = "spec-render"
  cmd = "pkspec spec --output docs/SPEC.md Spec.pkl Test.pkl"
  inputs { "Spec.pkl"; "Test.pkl"; "pkspec/**" }
  outputs { "docs/SPEC.md" }
}

local specRun = new Task {
  name = "spec-run"
  cmd = "pkspec exec -f Test.pkl"
  inputs { "Test.pkl"; "src/**/*.ts"; "fixtures/**" }
}

// ---- Aggregate ----

tasks {
  vlmkitTest
  bench
  introspectBench
  vlmkitDemo
  vlmkitDemoFix
  vlmkitDemoMulti
  vlmkitDemoMultistep
  cssBench
  cssBenchSelector
  cssBenchAll
  cssBenchCrater
  cssBenchPrescanner
  cssReport
  benchApprove
  migrationCompare
  migrationFixLoop
  migrationReset
  migrationTailwind
  migrationShadcn
  migrationSubagentPrepare
  migrationSubagentEvaluate
  migrationBlindList
  migrationBlindShow
  migrationBlindPrepare
  migrationBlindSolo
  migrationBlindEvaluate
  flakerVrtAdapt
  fixLoop
  vlmBench
  apiServer
  smokeTest
  snapshot
  dogfoodLuna
  dogfoodSol
  falsePositive
  smokeAll
  vlmkitHelp
  specCheck
  specLint
  specRender
  specRun
}
