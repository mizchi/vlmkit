      ]
    },
    {
      "id": "ja-light",
      "source": "http://127.0.0.1:4190/?lang=ja&theme=light",
      "extraGates": [
        "check a11y contrast --output-dir test-results/a11y-contrast/ja-light"
      ]
    },
    {
      "id": "ja-dark",
      "source": "http://127.0.0.1:4190/?lang=ja&theme=dark",
      "extraGates": [
        "check a11y contrast --output-dir test-results/a11y-contrast/ja-dark"
      ]
    }
