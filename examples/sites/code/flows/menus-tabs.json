{
  "viewport": { "width": 1280, "height": 800 },
  "steps": [
    { "label": "Code menu opens with Enter", "do": { "action": "press", "selector": "#btn-code", "key": "Enter" },
      "expect": [ { "assert": "attr", "selector": "#btn-code", "name": "aria-expanded", "equals": "true" }, { "assert": "visible", "selector": "#pop-code" } ] },
    { "label": "ArrowRight moves HTTPS -> CLI", "do": { "action": "press", "selector": "#ct-tab-https", "key": "ArrowRight" },
      "expect": [ { "assert": "attr", "selector": "#ct-tab-cli", "name": "aria-selected", "equals": "true" }, { "assert": "focused", "selector": "#ct-tab-cli" } ] },
    { "label": "Copy shows Copied!", "do": { "action": "click", "selector": "#pop-code .copy-btn" },
      "expect": [ { "assert": "text", "selector": "#pop-code .tooltip", "contains": "Copied!" } ] },
    { "label": "Escape closes it and returns focus", "do": { "action": "press", "selector": "#pop-code .copy-btn", "key": "Escape" },
      "expect": [ { "assert": "hidden", "selector": "#pop-code" }, { "assert": "focused", "selector": "#btn-code" } ] },
    { "label": "Watch menu", "do": { "action": "click", "selector": "#btn-watch" },
      "expect": [ { "assert": "visible", "selector": "#pop-watch" } ] },
    { "label": "choose All activity", "do": { "action": "click", "selector": "#pop-watch .choice:nth-of-type(1)" },
      "expect": [] },
    { "label": "branch selector: tags tab and a tag", "do": { "action": "click", "selector": "#btn-branch" },
      "expect": [ { "assert": "visible", "selector": "#branch-filter" } ] },
    { "label": "Tags", "do": { "action": "click", "selector": "#bt-tab-tags" },
      "expect": [ { "assert": "count", "selector": "#bt-panel .ref-item", "equals": 5 } ] },
    { "label": "Branches", "do": { "action": "click", "selector": "#bt-tab-branches" },
      "expect": [ { "assert": "count", "selector": "#bt-panel .ref-item", "equals": 8 } ] },
    { "label": "choose next", "do": { "action": "click", "selector": "#bt-panel li:nth-child(2) .ref-item" },
      "expect": [ { "assert": "text", "selector": "#btn-branch", "contains": "next" },
                  { "assert": "text", "selector": ".ft-head-inner .ft-msg", "contains": "incremental rebuild" },
                  { "assert": "hidden", "selector": "#pop-branch" } ] },
    { "label": "Star", "do": { "action": "click", "selector": "#btn-star" },
      "expect": [ { "assert": "text", "selector": "#btn-star", "contains": "Starred" }, { "assert": "text", "selector": "#btn-star", "contains": "4,219" }, { "assert": "attr", "selector": "#btn-star", "name": "aria-pressed", "equals": "true" } ] },
    { "label": "Unstar", "do": { "action": "click", "selector": "#btn-star" },
      "expect": [ { "assert": "text", "selector": "#btn-star", "contains": "4,218" } ] },
    { "label": "Fork dialog", "do": { "action": "click", "selector": "#btn-fork" },
      "expect": [ { "assert": "visible", "selector": "#fork-dialog" }, { "assert": "focused", "selector": "#fork-name" } ] },
    { "label": "Create fork", "do": { "action": "click", "selector": "#fork-dialog button[type=submit]" },
      "expect": [ { "assert": "hidden", "selector": "#fork-dialog" }, { "assert": "text", "selector": "#btn-fork", "contains": "313" }, { "assert": "focused", "selector": "#btn-fork" } ] },
    { "label": "to the new-issue form", "do": { "action": "click", "selector": "a.repo-tab[href='#/issues']" }, "expect": [] },
    { "label": "…render", "do": { "action": "wait", "ms": 250 }, "expect": [ { "assert": "visible", "selector": ".issues-head a.btn-primary" } ] },
    { "label": "New issue", "do": { "action": "click", "selector": ".issues-head a.btn-primary" }, "expect": [] },
    { "label": "…render", "do": { "action": "wait", "ms": 250 }, "expect": [ { "assert": "visible", "selector": "#nt-tab-write" } ] },
    { "label": "ArrowRight Write -> Preview", "do": { "action": "press", "selector": "#nt-tab-write", "key": "ArrowRight" },
      "expect": [ { "assert": "attr", "selector": "#nt-tab-preview", "name": "aria-selected", "equals": "true" }, { "assert": "focused", "selector": "#nt-tab-preview" }, { "assert": "text", "selector": ".preview", "contains": "Nothing to preview" } ] },
    { "label": "Label filter menu", "do": { "action": "click", "selector": "a.repo-tab[href='#/issues']" }, "expect": [] },
    { "label": "…render", "do": { "action": "wait", "ms": 250 }, "expect": [ { "assert": "visible", "selector": "#btn-f-label" } ] },
    { "label": "open Label", "do": { "action": "click", "selector": "#btn-f-label" }, "expect": [ { "assert": "visible", "selector": "#pop-f-label" } ] },
    { "label": "choose bug", "do": { "action": "click", "selector": "#pop-f-label li:nth-child(1) .choice" },
      "expect": [ { "assert": "attr", "selector": "#issue-search", "name": "id", "equals": "issue-search" }, { "assert": "count", "selector": ".issue-row", "equals": 9 } ] }
  ]
}
