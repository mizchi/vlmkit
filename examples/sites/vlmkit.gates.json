{
  "webServer": {
    "command": "node ../vlmkit-intro-page/server.mjs",
    "url": "http://127.0.0.1:4190/sites/",
    "reuseExistingServer": true
  },
  "defaults": {
    "gates": [
      "check integrity"
    ]
  },
  "pages": [
    {
      "id": "gallery",
      "source": "http://127.0.0.1:4190/sites/",
      "extraGates": [
        "check a11y contrast --output-dir test-results/a11y-contrast/sites-gallery"
      ]
    },
    {
      "id": "checkout",
      "source": "http://127.0.0.1:4190/sites/checkout/",
