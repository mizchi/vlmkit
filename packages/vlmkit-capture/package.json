{
  "name": "@mizchi/vlmkit-capture",
  "version": "0.11.1",
  "description": "Playwright + Crater capture infrastructure for VRT — viewport discovery, multi-route capture, prescanner.",
  "license": "MIT",
  "author": "mizchi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mizchi/vlmkit.git",
    "directory": "packages/vlmkit-capture"
  },
  "homepage": "https://github.com/mizchi/vlmkit/tree/main/packages/vlmkit-capture#readme",
  "bugs": {
    "url": "https://github.com/mizchi/vlmkit/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm --dir ../.. exec tsdown --config tsdown.packages.config.ts --filter @mizchi/vlmkit-capture",
    "prepack": "pnpm build",
    "test": "pnpm --dir ../.. exec vitest run packages/vlmkit-capture/src"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./*.ts": {
      "types": "./dist/*.d.mts",
      "import": "./dist/*.mjs"
    }
  },
  "dependencies": {
    "@mizchi/vlmkit-core": "workspace:*",
    "pngjs": "^7.0.0",
    "ws": "^8.20.0"
  },
  "peerDependencies": {
    "playwright": ">=1.61 <2"
  }
}
