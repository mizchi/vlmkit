{
  "name": "@mizchi/vlmkit-generate",
  "version": "0.9.0",
  "description": "Generator contract for Playwright tests: turns a Markdown plan and generation rules into a Playwright spec source file.",
  "license": "MIT",
  "author": "mizchi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mizchi/vlmkit.git",
    "directory": "packages/vlmkit-generate"
  },
  "homepage": "https://github.com/mizchi/vlmkit/tree/main/packages/vlmkit-generate#readme",
  "bugs": {
    "url": "https://github.com/mizchi/vlmkit/issues"
  },
  "type": "module",
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test 'src/**/*.test.ts'"
  },
  "bin": {
    "vlmkit-generate": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts",
    "./*.ts": "./src/*.ts"
  },
  "dependencies": {
    "@mizchi/vlmkit-ai": "workspace:*",
    "typescript": "^6.0.2"
  }
}
