{
  "name": "@mizchi/vlmkit-plan",
  "version": "0.10.0",
  "description": "Planner contract for Playwright test generation: turns a user story, seed test, PRD, and UI observations into a Markdown test plan.",
  "license": "MIT",
  "author": "mizchi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mizchi/vlmkit.git",
    "directory": "packages/vlmkit-plan"
  },
  "homepage": "https://github.com/mizchi/vlmkit/tree/main/packages/vlmkit-plan#readme",
  "bugs": {
    "url": "https://github.com/mizchi/vlmkit/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm --dir ../.. exec tsdown --config tsdown.packages.config.ts --filter @mizchi/vlmkit-plan",
    "prepack": "pnpm build",
    "test": "node --test 'src/**/*.test.ts'"
  },
  "bin": {
    "vlmkit-plan": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./cli": {
      "types": "./dist/cli.d.mts",
      "import": "./dist/cli.mjs"
    },
    "./*.ts": {
      "types": "./dist/*.d.mts",
      "import": "./dist/*.mjs"
    }
  },
  "dependencies": {
    "@mizchi/vlmkit-ai": "workspace:*"
  }
}
