{
  "name": "@mizchi/vlmkit-ai",
  "version": "0.11.1",
  "description": "VLM / LLM clients, reasoning pipeline, and NLP helpers used by VRT to interpret diff images and natural-language intent.",
  "license": "MIT",
  "author": "mizchi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mizchi/vlmkit.git",
    "directory": "packages/vlmkit-ai"
  },
  "homepage": "https://github.com/mizchi/vlmkit/tree/main/packages/vlmkit-ai#readme",
  "bugs": {
    "url": "https://github.com/mizchi/vlmkit/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm --dir ../.. exec tsdown --config tsdown.packages.config.ts --filter @mizchi/vlmkit-ai",
    "prepack": "pnpm build",
    "test": "pnpm --dir ../.. exec vitest run packages/vlmkit-ai/src"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./*.ts": {
      "types": "./dist/*.d.mts",
      "import": "./dist/*.mjs"
    }
  },
  "dependencies": {
    "@mizchi/vlmkit-core": "workspace:*",
    "@google/generative-ai": "^0.24.1"
  }
}
