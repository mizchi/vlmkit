{
  "name": "@mizchi/vlmkit-core",
  "version": "0.9.0",
  "description": "VRT diff engine + shared types — pure image / DOM / a11y / visual comparison primitives.",
  "license": "MIT",
  "author": "mizchi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mizchi/vlmkit.git",
    "directory": "packages/vlmkit-core"
  },
  "homepage": "https://github.com/mizchi/vlmkit/tree/main/packages/vlmkit-core#readme",
  "bugs": {
    "url": "https://github.com/mizchi/vlmkit/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm --dir ../.. exec tsdown --config tsdown.packages.config.ts --filter @mizchi/vlmkit-core",
    "prepack": "pnpm build",
    "test": "node --test 'src/**/*.test.ts'"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./*.ts": {
      "types": "./dist/*.d.mts",
      "import": "./dist/*.mjs"
    }
  },
  "dependencies": {
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0"
  },
  "peerDependencies": {
    "playwright": ">=1.61 <2"
  }
}
