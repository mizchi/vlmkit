{
  "name": "@mizchi/vlmkit-animation-eval",
  "version": "0.12.0",
  "description": "Frame-sampled animation evaluation for web pages: pause every Web Animation, seek deterministic sample points, and report visible effect, settle time, reduced-motion behaviour and uncontrolled motion. The measurement behind `vlmkit check animation` and `vlmkit-anim eval`.",
  "license": "MIT",
  "author": "mizchi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mizchi/vlmkit.git",
    "directory": "packages/vlmkit-animation-eval"
  },
  "homepage": "https://github.com/mizchi/vlmkit/tree/main/packages/vlmkit-animation-eval#readme",
  "bugs": {
    "url": "https://github.com/mizchi/vlmkit/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm --dir ../.. exec tsdown --config tsdown.packages.config.ts --filter @mizchi/vlmkit-animation-eval",
    "prepack": "pnpm build",
    "test": "pnpm --dir ../.. exec vitest run packages/vlmkit-animation-eval/src"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./*.ts": {
      "types": "./dist/*.d.mts",
      "import": "./dist/*.mjs"
    }
  },
  "dependencies": {
    "@mizchi/vlmkit-core": "workspace:*",
    "pngjs": "^7.0.0"
  },
  "peerDependencies": {
    "playwright": ">=1.61 <2"
  }
}
