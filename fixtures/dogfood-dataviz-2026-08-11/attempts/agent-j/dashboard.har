{"log":{"version":"1.2","creator":{"name":"Playwright","version":"1.61.1"},"browser":{"name":"chromium","version":"149.0.7827.55"},"pages":[{"startedDateTime":"2026-08-11T16:18:54.537Z","id":"page@09e68186941bd0e08579c6d3b7d12ef4","title":"Ops dashboard","pageTimings":{"onContentLoad":16,"onLoad":17}}],"entries":[{"pageref":"page@09e68186941bd0e08579c6d3b7d12ef4","startedDateTime":"2026-08-11T16:18:54.540Z","time":5.654999999999999,"request":{"method":"GET","url":"http://localhost:5202/","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Connection","value":"keep-alive"},{"name":"Host","value":"localhost:5202"},{"name":"Sec-Fetch-Dest","value":"document"},{"name":"Sec-Fetch-Mode","value":"navigate"},{"name":"Sec-Fetch-Site","value":"none"},{"name":"Sec-Fetch-User","value":"?1"},{"name":"Upgrade-Insecure-Requests","value":"1"},{"name":"User-Agent","value":"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/149.0.7827.55 Safari/537.36"},{"name":"sec-ch-ua","value":"\"HeadlessChrome\";v=\"149\", \"Chromium\";v=\"149\", \"Not)A;Brand\";v=\"24\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Linux\""}],"queryString":[],"headersSize":630,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Connection","value":"keep-alive"},{"name":"Date","value":"Tue, 11 Aug 2026 16:18:54 GMT"},{"name":"Keep-Alive","value":"timeout=5"},{"name":"Transfer-Encoding","value":"chunked"},{"name":"content-type","value":"text/html; charset=utf-8"}],"content":{"size":2470,"mimeType":"text/html; charset=utf-8","compression":0,"text":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Ops dashboard</title>\n<link rel=\"stylesheet\" href=\"theme.css\">\n</head>\n<body>\n<header class=\"topbar\">\n  <h1>Ops dashboard</h1>\n  <p class=\"region\">Region: apne1</p>\n</header>\n\n<main class=\"grid\">\n  <section class=\"panel\">\n    <h2>Queue depth</h2>\n    <p class=\"metric\" id=\"queue\">148</p>\n    <p class=\"status\">Above the alert line since 09:12</p>\n  </section>\n\n  <section class=\"panel\">\n    <h2>Latency p95</h2>\n    <p class=\"metric\" id=\"p95\">412 ms</p>\n    <p class=\"status\">Within budget</p>\n  </section>\n\n  <section class=\"panel\">\n    <h2>Error rate</h2>\n    <p class=\"metric\" id=\"err\">3.1%</p>\n    <p class=\"status\">TODO: confirm the denominator with the platform team</p>\n  </section>\n</main>\n\n<!-- Rendered by the charting library at runtime; we do not own this markup.\n     Kept in the page as-is so it behaves the way it does in production. -->\n<div class=\"vendorchart-ctrl-group\">\n  <div class=\"vendorchart-ctrl\">\n    <button class=\"vendorchart-ctrl-zoom-in\" aria-label=\"Zoom in\">\n      <svg viewBox=\"0 0 12 12\" width=\"12\" height=\"12\" aria-hidden=\"true\"><path d=\"M6 1v10M1 6h10\" stroke=\"currentColor\" stroke-width=\"2\" fill=\"none\"/></svg>\n    </button>\n    <button class=\"vendorchart-ctrl-zoom-out\" aria-label=\"Zoom out\">\n      <svg viewBox=\"0 0 12 12\" width=\"12\" height=\"12\" aria-hidden=\"true\"><path d=\"M1 6h10\" stroke=\"currentColor\" stroke-width=\"2\" fill=\"none\"/></svg>\n    </button>\n    <button class=\"vendorchart-ctrl-reset\" aria-label=\"Reset view\">\n      <svg viewBox=\"0 0 12 12\" width=\"12\" height=\"12\" aria-hidden=\"true\"><circle cx=\"6\" cy=\"6\" r=\"4\" stroke=\"currentColor\" stroke-width=\"2\" fill=\"none\"/></svg>\n    </button>\n  </div>\n</div>\n\n<footer class=\"actions\">\n  <button class=\"btn btn--primary\" id=\"acknowledge\">Acknowledge</button>\n  <button class=\"btn\" id=\"snooze\">Snooze 1h</button>\n  <button class=\"btn\" id=\"escalate\">Escalate</button>\n</footer>\n\n<script>\n  // The live feed the deployment keeps open. Not decorative: closing it is what\n  // the page is for.\n  new EventSource(\"/api/live\");\n  fetch(\"/api/metrics\").then((r) => r.json()).then((m) => {\n    document.getElementById(\"queue\").textContent = String(m.queueDepth);\n    document.getElementById(\"p95\").textContent = m.p95Ms + \" ms\";\n    document.getElementById(\"err\").textContent = (m.errorRate * 100).toFixed(1) + \"%\";\n  });\n</script>\n</body>\n</html>\n"},"headersSize":171,"bodySize":2482,"redirectURL":"","_transferSize":2653},"cache":{},"timings":{"dns":0.071,"connect":0.548,"ssl":1.888,"send":0,"wait":1.112,"receive":2.036},"_resourceType":"document","serverIPAddress":"127.0.0.1","_serverPort":5202,"_securityDetails":{}},{"pageref":"page@09e68186941bd0e08579c6d3b7d12ef4","startedDateTime":"2026-08-11T16:18:54.547Z","time":4.115,"request":{"method":"GET","url":"http://localhost:5202/theme.css","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"text/css,*/*;q=0.1"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Connection","value":"keep-alive"},{"name":"Host","value":"localhost:5202"},{"name":"Referer","value":"http://localhost:5202/"},{"name":"Sec-Fetch-Dest","value":"style"},{"name":"Sec-Fetch-Mode","value":"no-cors"},{"name":"Sec-Fetch-Site","value":"same-origin"},{"name":"User-Agent","value":"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/149.0.7827.55 Safari/537.36"},{"name":"sec-ch-ua","value":"\"HeadlessChrome\";v=\"149\", \"Chromium\";v=\"149\", \"Not)A;Brand\";v=\"24\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Linux\""}],"queryString":[],"headersSize":508,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Connection","value":"keep-alive"},{"name":"Date","value":"Tue, 11 Aug 2026 16:18:54 GMT"},{"name":"Keep-Alive","value":"timeout=5"},{"name":"Transfer-Encoding","value":"chunked"},{"name":"content-type","value":"text/css; charset=utf-8"}],"content":{"size":1667,"mimeType":"text/css; charset=utf-8","compression":0,"text":"/* Ops dashboard theme.\n *\n * Every declared defect lives in this file or in the markup's own text. Nothing\n * is annotated as wrong — the point of the exercise is whether the tool says so.\n */\n* { box-sizing: border-box; }\n\nbody {\n  margin: 0;\n  font: 16px/1.5 system-ui, sans-serif;\n  color: #222;\n  background: #fff;\n}\n\n.topbar {\n  display: flex;\n  align-items: baseline;\n  gap: 16px;\n  padding: 20px 24px;\n  border-bottom: 1px solid #e3e3e3;\n}\n\n.topbar h1 { margin: 0; font-size: 20px; font-weight: 600; }\n.region { margin: 0; font-size: 14px; color: #666; }\n\n.grid {\n  display: grid;\n  grid-template-columns: repeat(3, 240px);\n  gap: 24px;\n  padding: 24px;\n}\n\n.panel {\n  padding: 16px;\n  border: 1px solid #333;\n  border-radius: 8px;\n  background: #fff;\n}\n\n.panel h2 { margin: 0 0 8px; font-size: 14px; font-weight: 600; }\n.metric { margin: 0 0 8px; font-size: 32px; font-weight: 700; }\n\n.status {\n  margin: 0;\n  font-size: 13px;\n  color: #a8a8a8;\n}\n\n.vendorchart-ctrl-group {\n  padding: 0 24px 24px;\n}\n\n.vendorchart-ctrl {\n  display: inline-flex;\n  gap: 4px;\n}\n\n.vendorchart-ctrl button {\n  width: 24px;\n  height: 24px;\n  padding: 0;\n  border: 0;\n  border-radius: 0;\n  background: rgba(0, 0, 0, 0);\n  color: #222;\n  cursor: pointer;\n}\n\n.actions {\n  display: flex;\n  gap: 16px;\n  padding: 0 24px 24px;\n}\n\n.btn {\n  min-height: 44px;\n  padding: 10px 18px;\n  font: inherit;\n  border: 1px solid #333;\n  border-radius: 8px;\n  background: #fff;\n  color: #222;\n  cursor: pointer;\n}\n\n.btn--primary {\n  border-color: #2255cc;\n  background: #2255cc;\n  color: #fff;\n}\n\n@media (max-width: 767px) {\n  .grid { grid-template-columns: 1fr; }\n  .actions { flex-wrap: wrap; }\n}\n"},"headersSize":170,"bodySize":1679,"redirectURL":"","_transferSize":1849},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":0.889,"receive":3.226},"_resourceType":"stylesheet","serverIPAddress":"127.0.0.1","_serverPort":5202,"_securityDetails":{}},{"pageref":"page@09e68186941bd0e08579c6d3b7d12ef4","startedDateTime":"2026-08-11T16:18:54.552Z","time":5.247,"request":{"method":"GET","url":"http://localhost:5202/api/metrics","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"*/*"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Connection","value":"keep-alive"},{"name":"Host","value":"localhost:5202"},{"name":"Referer","value":"http://localhost:5202/"},{"name":"Sec-Fetch-Dest","value":"empty"},{"name":"Sec-Fetch-Mode","value":"cors"},{"name":"Sec-Fetch-Site","value":"same-origin"},{"name":"User-Agent","value":"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/149.0.7827.55 Safari/537.36"},{"name":"sec-ch-ua","value":"\"HeadlessChrome\";v=\"149\", \"Chromium\";v=\"149\", \"Not)A;Brand\";v=\"24\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Linux\""}],"queryString":[],"headersSize":492,"bodySize":0},"response":{"status":200,"statusText":"application/json","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Connection","value":"keep-alive"},{"name":"Date","value":"Tue, 11 Aug 2026 16:18:54 GMT"},{"name":"Keep-Alive","value":"timeout=5"},{"name":"Transfer-Encoding","value":"chunked"}],"content":{"size":65,"mimeType":"x-unknown","compression":0,"text":"eyJxdWV1ZURlcHRoIjoxNDgsInA5NU1zIjo0MTIsImVycm9yUmF0ZSI6MC4wMzEsInJlZ2lvbiI6ImFwbmUxIn0=","encoding":"base64"},"headersSize":145,"bodySize":76,"redirectURL":"","_transferSize":221},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":2.65,"receive":2.597},"_resourceType":"fetch","serverIPAddress":"127.0.0.1","_serverPort":5202,"_securityDeta