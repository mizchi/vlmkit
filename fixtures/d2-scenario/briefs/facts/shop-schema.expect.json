{
  "_note": "Scorer's truth for the shop-schema brief. NOT given to writers in v1.",
  "tables": {
    "customers": ["id", "email", "created_at"],
    "orders": ["id", "customer_id", "status", "placed_at"],
    "order_items": ["id", "order_id", "product_id", "quantity"],
    "products": ["id", "sku", "price_cents"],
    "shipments": ["id", "order_id", "carrier", "tracking_code"]
  },
  "primaryKeys": {
    "customers": "id",
    "orders": "id",
    "order_items": "id",
    "products": "id",
    "shipments": "id"
  },
  "foreignKeys": {
    "orders": ["customer_id"],
    "order_items": ["order_id", "product_id"],
    "shipments": ["order_id"]
  },
  "deps": [
    "orders.customer_id->customers.id",
    "order_items.order_id->orders.id",
    "order_items.product_id->products.id",
    "shipments.order_id->orders.id"
  ],
  "edgeCount": 4,
  "columnLevelEdges": true,
  "maxColumns": 100
}
