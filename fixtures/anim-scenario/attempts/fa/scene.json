    ["cli", "core"],
    ["cli", "generate"],
    ["cli", "heal"],
    ["cli", "markup"],
    ["cli", "mcp"],
    ["cli", "plan"]
  ],
  "groups": [
    { "id": "browser", "label": "needs a browser (required Playwright peer)", "modules": ["core", "capture", "animation-eval", "heal", "markup"] },
    { "id": "pure", "label": "pure (no Playwright)", "modules": ["ai", "generate", "mcp", "plan"] },
    { "id": "optional-browser", "label": "browser only for .png / eval", "modules": ["anim"] }
  ]
