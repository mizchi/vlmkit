{
  "format": "vlmkit-anim/scene@1",
  "kind": "state-machine",
  "title": "TCP Connection Teardown",
  "states": [
    "ESTABLISHED",
    "FIN_WAIT_1",
    "FIN_WAIT_2",
    "CLOSING",
    "TIME_WAIT",
    { "id": "CLOSED", "final": true }
  ],
  "initial": "ESTABLISHED",
  "transitions": [
    { "from": "ESTABLISHED", "to": "FIN_WAIT_1", "on": "close", "note": "/ send FIN" },
    { "from": "FIN_WAIT_1", "to": "FIN_WAIT_2", "on": "ACK", "note": "/ receive ACK" },
    { "from": "FIN_WAIT_1", "to": "CLOSING", "on": "FIN", "note": "/ receive FIN, send ACK" },
    { "from": "FIN_WAIT_2", "to": "TIME_WAIT", "on": "FIN", "note": "/ receive FIN, send ACK" },
    { "from": "CLOSING", "to": "TIME_WAIT", "on": "ACK", "note": "/ receive ACK" },
    { "from": "TIME_WAIT", "to": "CLOSED", "on": "timeout", "note": "/ 2MSL timer expires" }
  ],
  "trace": [
    "close",
    "ACK",
    "FIN",
    "timeout",
    { "goto": "FIN_WAIT_1", "caption": "Alternative path: simultaneous close" },
    "FIN",
    "ACK"
  ]
}
