{
  "format": "vlmkit-anim/scene@1",
  "kind": "modules",
  "title": "Ports and adapters: dependency flow",
  "modules": [
    { "id": "http", "label": "HTTP handler" },
    { "id": "cli", "label": "CLI command" },
    { "id": "app-svc", "label": "Application\nservices" },
    { "id": "domain", "label": "Domain model" },
    { "id": "repo-port", "label": "Repository\nport (interface)" },
