{
  "format": "vlmkit-anim/scene@1",
  "kind": "modules",
  "title": "Ports and Adapters (Hexagonal Architecture)",
  "modules": [
    "http",
    "cli",
    "app",
    "domain",
    "port",
    "postgres",
    "memory"
  ],
  "deps": [
    ["http", "app"],
    ["cli", "app"],
    ["app", "domain"],
    ["app", "port"],
    ["port", "domain"],
    ["postgres", "port"],
    ["memory", "port"],
    {
      "from": "domain",
      "to": "postgres",
      "style": "forbidden",
      "label": "never"
    }
  ],
  "groups": [
    {
      "id": "driving",
      "label": "Driving side",
      "modules": ["http", "cli"]
    },
    {
      "id": "core",
      "label": "Core",
      "modules": ["app", "domain", "port"]
    },
    {
      "id": "adapters",
      "label": "Adapters",
      "modules": ["postgres", "memory"]
    }
  ]
}
