{
  "format": "vlmkit-anim/scene@1",
  "kind": "vector",
  "title": "Batched Pandora's Box: Adaptive Policy",
  "canvas": { "width": 700, "height": 500 },
  "stepMs": 700,
  "nodes": [
    { "id": "title", "shape": "text", "pos": [350, 25], "text": "Batched Pandora's Box: k=2, T=1/5", "fontSize": 16, "anchor": "middle", "fill": "#1f2937" },
    { "id": "box1", "shape": "rect", "pos": [120, 100], "size": [50, 70], "fill": "#e5e7eb", "stroke": "#374151", "strokeWidth": 2 },
    { "id": "label1", "shape": "text", "pos": [120, 190], "text": "Box 1\ncost 1/5", "fontSize": 11, "anchor": "middle" },
    { "id": "box2", "shape": "rect", "pos": [280, 100], "size": [50, 70], "fill": "#e5e7eb", "stroke": "#374151", "strokeWidth": 2 },
    { "id": "label2", "shape": "text", "pos": [280, 190], "text": "Box 2\ncost 1/5", "fontSize": 11, "anchor": "middle" },
    { "id": "box3", "shape": "rect", "pos": [440, 100], "size": [50, 70], "fill": "#e5e7eb", "stroke": "#374151", "strokeWidth": 2, "opacity": 0 },
    { "id": "label3", "shape": "text", "pos": [440, 190], "text": "Box 3\ncost 1", "fontSize": 11, "anchor": "middle", "opacity": 0 },
    { "id": "reward1", "shape": "text", "pos": [120, 105], "text": "", "fontSize": 16, "fill": "#10b981", "anchor": "middle", "opacity": 0 },
    { "id": "reward2", "shape": "text", "pos": [280, 105], "text": "", "fontSize": 16, "fill": "#10b981", "anchor": "middle", "opacity": 0 },
    { "id": "reward3", "shape": "text", "pos": [440, 105], "text": "", "fontSize": 16, "fill": "#10b981", "anchor": "middle", "opacity": 0 },
    { "id": "batch1_label", "shape": "text", "pos": [200, 40], "text": "Batch 1", "fontSize": 13, "fill": "#6b7280", "opacity": 0 },
    { "id": "batch2_label", "shape": "text", "pos": [440, 40], "text": "Batch 2", "fontSize": 13, "fill": "#6b7280", "opacity": 0 },
    { "id": "cost_panel", "shape": "text", "pos": [600, 280], "text": "", "fontSize": 12, "anchor": "start", "fill": "#1f2937" },
    { "id": "best_panel", "shape": "text", "pos": [600, 310], "text": "", "fontSize": 12, "anchor": "start", "fill": "#1f2937" },
    { "id": "decision_panel", "shape": "text", "pos": [350, 270], "text": "", "fontSize": 12, "anchor": "middle", "fill": "#1f2937" }
  ],
  "timeline": [
    { "target": "batch1_label", "to": { "opacity": 1 }, "duration": 0, "caption": "Batch 1: Open boxes 1 and 2 together" },
    { "target": "box1", "to": { "fill": "#fcd34d" }, "duration": 300, "at": "<" },
    { "target": "box2", "to": { "fill": "#fcd34d" }, "duration": 300, "at": "<" },
    { "target": "reward1", "to": { "text": "1/2", "opacity": 1 }, "duration": 0, "caption": "Box 1 reveals: 1/2 (always this value)" },
    { "target": "best_panel", "to": { "text": "Best: 1/2" }, "duration": 0 },
    { "target": "cost_panel", "to": { "text": "Cost: 3/5 (box costs 1/5+1/5 + setup 1/5)" }, "duration": 0 },
    { "target": "reward2", "to": { "text": "1/2", "opacity": 1 }, "duration": 0, "caption": "Box 2 reveals: 1/2 (not the rare 99 outcome)" },
    { "target": "best_panel", "to": { "text": "Best: still 1/2" }, "duration": 0 },
    { "target": "decision_panel", "to": { "text": "Current best is modest. Should we open batch 2?" }, "duration": 0, "caption": "Decision: evaluate batch 2" },
    { "wait": 500, "caption": "Box 3 expected reward: 1/5 × 10 = 2. Batch 2 cost: 1 + 1/5 = 6/5 = 1.2" },
    { "target": "decision_panel", "to": { "text": "Incremental gain: 1/5×(10−1/2) = 1.9. Cost: 1.2. Gain > Cost? YES!" }, "duration": 0, "caption": "Expected gain 1.9 > cost 1.2 → open batch 2" },
    { "target": "batch2_label", "to": { "opacity": 1 }, "duration": 0, "caption": "Batch 2: Open box 3 alone" },
    { "target": "box3", "to": { "opacity": 1, "fill": "#fcd34d" }, "duration": 300 },
    { "target": "label3", "to": { "opacity": 1 }, "duration": 300, "at": "<" },
    { "target": "reward3", "to": { "text": "10", "opacity": 1 }, "duration": 0, "caption": "Box 3 reveals: 10 (the good outcome; prob 1/5)" },
    { "target": "best_panel", "to": { "text": "Best: 10" }, "duration": 0 },
    { "target": "cost_panel", "to": { "text": "Total cost: 3/5 + 6/5 = 9/5" }, "duration": 0 },
    { "target": "decision_panel", "to": { "text": "Final score: 10 − 9/5 = 8/5 = 1.6" }, "duration": 0, "caption": "Final score with adaptive policy: 1.6" },
    { "wait": 600, "caption": "If box 2 had shown 99: stop. Score would be 99−3/5≈98.4. Policy adapts to reward signals." },
    { "wait": 400, "caption": "This adaptive policy (deciding after each batch) beats any fixed menu, bounded by 2×. On this instance: ~1.19×" }
  ]
}
