{
  "format": "vlmkit-anim/scene@1",
  "kind": "vector",
  "title": "Batched Pandora's Box",
  "canvas": { "width": 600, "height": 500 },
  "stepMs": 600,
  "nodes": [
    { "id": "title", "shape": "text", "pos": [300, 30], "text": "Batched Pandora's Box: k=2, T=1/5", "fontSize": 18, "anchor": "middle" },
    { "id": "box1_batch1", "shape": "rect", "pos": [100, 120], "size": [50, 70], "fill": "#d1d5db", "stroke": "#374151", "strokeWidth": 2 },
    { "id": "label1", "shape": "text", "pos": [100, 210], "text": "Box 1\ncost 1/5", "fontSize": 12, "anchor": "middle" },
    { "id": "box2_batch1", "shape": "rect", "pos": [250, 120], "size": [50, 70], "fill": "#d1d5db", "stroke": "#374151", "strokeWidth": 2 },
    { "id": "label2", "shape": "text", "pos": [250, 210], "text": "Box 2\ncost 1/5", "fontSize": 12, "anchor": "middle" },
    { "id": "box3_batch2", "shape": "rect", "pos": [400, 120], "size": [50, 70], "fill": "#d1d5db", "stroke": "#374151", "strokeWidth": 2, "opacity": 0.3 },
    { "id": "label3", "shape": "text", "pos": [400, 210], "text": "Box 3\ncost 1", "fontSize": 12, "anchor": "middle", "opacity": 0.3 },
    { "id": "reward1", "shape": "text", "pos": [100, 140], "text": "", "fontSize": 14, "fill": "#22c55e", "anchor": "middle", "opacity": 0 },
    { "id": "reward2a", "shape": "text", "pos": [250, 140], "text": "", "fontSize": 14, "fill": "#22c55e", "anchor": "middle", "opacity": 0 },
    { "id": "reward3", "shape": "text", "pos": [400, 140], "text": "", "fontSize": 14, "fill": "#22c55e", "anchor": "middle", "opacity": 0 },
    { "id": "status_panel", "shape": "text", "pos": [300, 350], "text": "Best: — | Cost: —", "fontSize": 13, "anchor": "middle", "fill": "#1f2937" },
    { "id": "decision_text", "shape": "text", "pos": [300, 420], "text": "", "fontSize": 12, "anchor": "middle", "fill": "#1f2937" }
  ],
  "timeline": [
    { "target": "box1_batch1", "to": { "fill": "#fbbf24" }, "duration": 300, "caption": "Batch 1: Open boxes 1 and 2 together (setup + costs = 3/5)" },
    { "target": "box2_batch1", "to": { "fill": "#fbbf24" }, "duration": 300, "at": "<" },
    { "target": "reward1", "to": { "text": "1/2", "opacity": 1 }, "duration": 0, "caption": "Box 1: reward always 1/2" },
    { "target": "status_panel", "to": { "text": "Best: 1/2 | Cost: 3/5" }, "duration": 0 },
    { "target": "reward2a", "to": { "text": "99", "opacity": 1 }, "duration": 0, "caption": "Box 2: reward 99 (rare draw, 1/5 probability)" },
    { "target": "status_panel", "to": { "text": "Best: 99 | Cost: 3/5" }, "duration": 0 },
    { "wait": 400, "caption": "Branch: Box 2 showed 99. Is batch 2 worth the cost?" },
    { "target": "decision_text", "to": { "text": "Expected gain from box 3: 1/5 × 10 = 2. Cost: 6/5 = 1.2. Not worth it." }, "duration": 0, "caption": "Path A (Box 2=99): Stop here. Final score: 99 − 3/5 ≈ 98.4" },
    { "target": "box1_batch1", "to": { "fill": "#d1d5db" }, "duration": 200, "caption": "Boxes 1 and 2 close — resetting to show Path B" },
    { "target": "box2_batch1", "to": { "fill": "#d1d5db" }, "duration": 200, "at": "<" },
    { "target": "reward1", "to": { "opacity": 0 }, "duration": 200, "at": "<" },
    { "target": "reward2a", "to": { "opacity": 0 }, "duration": 200, "at": "<" },
    { "target": "reward1", "to": { "text": "1/2", "opacity": 1 }, "duration": 0, "caption": "Path B: Box 2 showed 1/2 (or 0) instead of 99" },
    { "target": "reward2a", "to": { "text": "1/2", "opacity": 1 }, "duration": 0, "at": "<" },
    { "target": "status_panel", "to": { "text": "Best: 1/2 | Cost: 3/5" }, "duration": 0 },
    { "target": "decision_text", "to": { "text": "Box 1 gave 1/2. Should we open batch 2 with box 3?" }, "duration": 0 },
    { "target": "box3_batch2", "to": { "opacity": 1 }, "duration": 300, "caption": "Batch 2: open box 3 alone (cost 1 + setup 1/5 = 6/5)" },
    { "target": "label3", "to": { "opacity": 1 }, "duration": 300, "at": "<" },
    { "target": "box3_batch2", "to": { "fill": "#fbbf24" }, "duration": 300, "caption": "Box 3 opens" },
    { "target": "reward3", "to": { "text": "10", "opacity": 1 }, "duration": 0, "caption": "Box 3 shows 10" },
    { "target": "status_panel", "to": { "text": "Best: 10 | Total cost: 9/5" }, "duration": 0 },
    { "target": "decision_text", "to": { "text": "Why open? Expected gain 1/5×(10−1/2)=1.9 > cost 1.2 ✓" }, "duration": 0 },
    { "wait": 500, "caption": "Adaptive policy beats fixed menus. Proof: bounded by 2×; on this instance ~1.19×" }
  ]
}
