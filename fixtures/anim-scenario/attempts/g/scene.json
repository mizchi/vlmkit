{
  "format": "vlmkit-anim/scene@1",
  "kind": "distributed",
  "title": "Primary-replica write with a failover",
  "nodes": ["client", { "id": "primary", "status": "leader" }, "replica", "backup"],
  "messages": [
    { "from": "client", "to": "primary", "label": "write x=1" },
    { "from": "primary", "to": "replica", "label": "replicate x=1" },
    { "from": "replica", "to": "primary", "label": "ack", "latency": 1200, "caption": "ack is slow: replica's disk is under load" },
    { "from": "replica", "to": "backup", "label": "copy x=1" },
    { "from": "primary", "to": "client", "label": "ok" },
    { "from": "client", "to": "primary", "label": "write x=2", "lost": true, "caption": "primary has crashed: the write is lost" },
    { "from": "client", "to": "replica", "label": "write x=2", "caption": "client retries against the promoted replica" }
  ],
  "events": [
    { "at": 3700, "node": "primary", "status": "down", "caption": "primary crashes" },
    { "at": 4200, "node": "replica", "status": "leader", "caption": "replica is promoted" }
  ]
}
