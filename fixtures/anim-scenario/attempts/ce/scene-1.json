{
  "format": "vlmkit-anim/scene@1",
  "kind": "vector",
  "title": "Batched Pandora's Box: adaptive policy",
  "canvas": { "width": 600, "height": 420, "background": "#f9f5f0" },
  "theme": { "fontSize": 13, "node": "#e0e0e0", "nodeStroke": "#666", "text": "#000", "accent": "#0066cc", "muted": "#999" },
  "stepMs": 600,
  "nodes": [
    { "id": "box1", "shape": "rect", "pos": [90, 120], "size": [50, 70], "fill": "#e8e8e8", "stroke": "#666", "strokeWidth": 2 },
    { "id": "label1-cost", "shape": "text", "pos": [90, 210], "text": "cost 1/5", "fontSize": 11 },
    { "id": "reward1", "shape": "text", "pos": [90, 70], "text": "1/2", "color": "#0066cc", "fontSize": 12, "opacity": 0 },
    { "id": "box2", "shape": "rect", "pos": [190, 120], "size": [50, 70], "fill": "#e8e8e8", "stroke": "#666", "strokeWidth": 2 },
    { "id": "label2-cost", "shape": "text", "pos": [190, 210], "text": "cost 1/5", "fontSize": 11 },
    { "id": "reward2", "shape": "text", "pos": [190, 70], "text": "1/2", "color": "#0066cc", "fontSize": 12, "opacity": 0 },
    { "id": "box3", "shape": "rect", "pos": [290, 120], "size": [50, 70], "fill": "#e8e8e8", "stroke": "#666", "strokeWidth": 2 },
    { "id": "label3-cost", "shape": "text", "pos": [290, 210], "text": "cost 1", "fontSize": 11 },
    { "id": "reward3", "shape": "text", "pos": [290, 70], "text": "10", "color": "#0066cc", "fontSize": 12, "opacity": 0 },
    { "id": "state-header", "shape": "text", "pos": [450, 30], "text": "State", "fontSize": 13, "anchor": "start" },
    { "id": "best-value", "shape": "text", "pos": [450, 60], "text": "best: —", "fontSize": 13, "anchor": "start" },
    { "id": "cost-value", "shape": "text", "pos": [450, 90], "text": "cost: 0", "fontSize": 13, "anchor": "start" },
    { "id": "batch1-marker", "shape": "text", "pos": [140, 250], "text": "Batch 1", "fontSize": 11, "color": "#0066cc", "opacity": 0 },
    { "id": "batch2-marker", "shape": "text", "pos": [290, 250], "text": "Batch 2", "fontSize": 11, "color": "#0066cc", "opacity": 0 }
  ],
  "timeline": [
    { "wait": 400, "caption": "Three closed boxes, each costs something to open, rewards are random from a known distribution." },
    { "target": "reward1", "to": { "opacity": 0.3 }, "duration": 0, "at": "<" },
    { "target": "reward2", "to": { "opacity": 0.3 }, "duration": 0, "at": "<" },
    { "target": "reward3", "to": { "opacity": 0.3 }, "duration": 0, "at": "<" },
    { "wait": 300, "caption": "Box 1: always 1/2. Box 2: shows 0, 1/2, or 99 (equal chance). Box 3: shows 10 or 0 (1/5 vs 4/5)." },
    { "wait": 400, "caption": "Goal: open boxes in batches. At any point, stop and keep the best reward seen. Score = best reward − total cost." },
    { "target": "batch1-marker", "to": { "opacity": 1 }, "duration": 300, "caption": "Step 1: open boxes 1 & 2 as a batch (setup cost 1/5 adds to their individual costs)" },
    { "target": ["box1", "box2"], "to": { "fill": "#a8e6a8" }, "duration": 300, "at": "<" },
    { "target": "cost-value", "to": { "text": "cost: 3/5" }, "duration": 0, "at": "<", "caption": "Batch cost: 1/5 + 1/5 + setup 1/5 = 3/5" },
    { "wait": 300, "caption": "Both rewards appear at once (that is the constraint of batching)." },
    { "target": "reward1", "to": { "opacity": 1 }, "duration": 400, "caption": "Box 1 reveals 1/2" },
    { "target": "reward2", "to": { "opacity": 1 }, "duration": 400, "at": "<", "caption": "Box 2 reveals 1/2 (we draw this outcome; it could have been 0 or 99)" },
    { "target": "best-value", "to": { "text": "best: 1/2" }, "duration": 0, "at": "<" },
    { "wait": 500, "caption": "Now we decide: should we open box 3? It costs 1 + setup 1/5 = 6/5." },
    { "wait": 400, "caption": "If box 3 shows 10 (1/5 chance), we gain 10 − 1/2 = 9/2 = 4.5 in value, expected = 1/5 × 9/2 = 9/10 = 0.9. Wait, let me recalculate..." },
    { "wait": 300, "caption": "Expected reward gain = 1/5 × (10 − 1/2) = 1/5 × 9.5 = 1.9. Cost = 6/5 = 1.2. So 1.9 > 1.2, open it." },
    { "target": "batch2-marker", "to": { "opacity": 1 }, "duration": 300, "caption": "Step 2: open box 3 as a second batch" },
    { "target": "box3", "to": { "fill": "#a8e6a8" }, "duration": 300, "at": "<" },
    { "target": "cost-value", "to": { "text": "cost: 9/5" }, "duration": 0, "at": "<", "caption": "New total cost: 3/5 + 6/5 = 9/5 = 1.8" },
    { "wait": 300, "caption": "Box 3 opens." },
    { "target": "reward3", "to": { "opacity": 1 }, "duration": 400, "caption": "Box 3 shows 10 (the lucky outcome)" },
    { "target": "best-value", "to": { "text": "best: 10" }, "duration": 0, "at": "<" },
    { "wait": 400, "caption": "Final score: 10 − 9/5 = 41/5 = 8.2." },
    { "wait": 400, "caption": "An adaptive policy (react after batch 1) beats a fixed menu: we chose batch 2 after seeing batch 1's outcome." }
  ]
}
