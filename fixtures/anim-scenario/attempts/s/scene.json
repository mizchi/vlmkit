{
  "format": "vlmkit-anim/scene@1",
  "kind": "distributed",
  "title": "Raft leader election",
  "timing": "causal",
  "nodes": [
    { "id": "n1", "label": "n1", "status": "leader" },
    { "id": "n2", "label": "n2" },
    { "id": "n3", "label": "n3" }
  ],
  "messages": [
    { "from": "n1", "to": "n2", "label": "hb-n2", "caption": "Leader n1 sends heartbeat to n2" },
    { "from": "n1", "to": "n3", "label": "hb-n3", "at": "<", "caption": "and to n3 (broadcast)" },
    { "from": "n2", "to": "n1", "label": "vote-n1", "lost": true, "caption": "n2 times out and requests vote from n1 (lost)" },
    { "from": "n2", "to": "n3", "label": "vote-n3", "at": "<", "caption": "and requests vote from n3" },
    { "from": "n3", "to": "n2", "label": "vote-grant", "caption": "n3 grants its vote to n2" },
    { "from": "n2", "to": "n3", "label": "hb2-n3", "caption": "n2 becomes leader and sends heartbeat to n3" }
  ],
  "events": [
    { "after": "hb-n3", "node": "n1", "status": "down", "delay": 100, "caption": "n1 crashes" },
    { "after": "vote-grant", "node": "n2", "status": "leader" }
  ]
}
