  "sequence": [
    {
      "highlight": "Input",
      "caption": "The pipeline starts with two sources: git changes and playwright screenshots"
    },
    {
      "highlight": ["Track_Intent", "Track_Visual", "Track_A11y"],
      "caption": "Three independent tracks analyze the change in parallel"
    },
    {
      "highlight": "Track_Intent",
      "caption": "Track 1: Parse the diff and infer intent (feature, bugfix, refactor, etc.)"
    },
    {
      "highlight": "Track_Visual",
      "caption": "Track 2: Compute visual semantic diff (regions, colors, layout changes)"
    },
    {
      "highlight": "Merge",
      "caption": "Cross-validate the results and produce a unified verdict"
    },
    {
      "flow": "VERDICTS->QC",
      "caption": "Quality checks filter out false positives and verify coverage"
