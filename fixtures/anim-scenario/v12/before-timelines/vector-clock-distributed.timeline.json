  "steps": [
    {
      "t": 0,
      "caption": "Start: A, B and C each hold a vector [a,b,c] of counters, all zero · A = [0,0,0] · B = [0,0,0] · C = [0,0,0]"
    },
    {
      "t": 540,
      "caption": "A has a local event: it increments its own slot · A: [0,0,0] -> [1,0,0]"
    },
    {
      "t": 1080,
      "caption": "A has a second local event before sending: it increments its own slot again · A: [1,0,0] -> [2,0,0]"
    },
    {
      "t": 1620,
      "caption": "A sends its vector to B · B receives [2,0,0]: max([0,0,0],[2,0,0])=[2,0,0], then +1 own slot -> [2,1,0]"
    },
    {
      "t": 2220,
      "caption": "Meanwhile, C has a local event of its own: it increments its own slot · C: [0,0,0] -> [0,0,1] · C's local event (frozen) = [0,0,1]"
    },
    {
      "t": 2760,
      "caption": "B sends its vector to C · C receives [2,1,0]: max([0,0,1],[2,1,0])=[2,1,1], then +1 own slot -> [2,1,2]"
    },
    {
      "t": 3360,
      "caption": "Concurrent: A's vector when it sent to B [2,0,0] and C's local event [0,0,1] - neither is <= the other"
    },
    {
      "t": 3900,
      "caption": "A ∥ C: concurrent"
    },
    {
      "t": 4440,
      "caption": "Ordered: A's vector [2,0,0] <= C's final vector [2,1,2] in every slot - A's send happened-before C's receive"
    },
    {
      "t": 4980,
      "caption": "A ≤ C: ordered"
    },
    {
      "t": 5520,
      "label": "end",
      "caption": "end"
    }
