{
  "format": "vlmkit-anim/scene@1",
  "kind": "matrix",
  "title": "Gaussian elimination: pick a pivot, clear below it",
  "rowLabels": ["r0", "r1", "r2"],
  "colLabels": ["x", "y", "z", "="],
  "cells": [
    [0, 2, 1, 4],
    [3, 1, 0, 5],
    [1, 1, 1, 6]
  ],
  "ops": [
    { "highlight": { "col": 0 }, "caption": "Column x: the first pivot must be non-zero" },
    { "highlight": { "cell": [0, 0] }, "caption": "r0 has 0 there: it cannot be the pivot row" },
    { "unhighlight": "all" },
    { "swap": { "rows": [0, 1] }, "caption": "Swap r0 and r1 so the pivot is 3" },
    { "mark": { "cell": [0, 0] }, "caption": "Pivot: 3" },
    { "set": { "cell": [2, 0], "value": 0, "from": [[0, 0], [2, 0]] }, "caption": "r2 − (1/3)·pivot row: the x entry becomes 0" },
    { "set": { "cell": [2, 1], "value": "2/3", "from": [[0, 1], [2, 1]] } },
    { "set": { "cell": [2, 2], "value": 1, "from": [[0, 2], [2, 2]] } },
    { "set": { "cell": [2, 3], "value": "13/3", "from": [[0, 3], [2, 3]] } },
    { "note": "Column x is clear below the pivot; the next pivot is in column y" }
  ]
}
