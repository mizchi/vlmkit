{
  "format": "vlmkit-anim/scene@1",
  "kind": "distributed",
  "title": "Primary-replica write with a failover",
  "timing": "causal",
  "nodes": [
    "client",
    {
      "id": "primary",
      "status": "leader"
    },
    "replica"
  ],
  "messages": [
    {
      "from": "client",
      "to": "primary",
      "label": "write x=1"
    },
    {
      "from": "primary",
      "to": "replica",
      "label": "replicate x=1"
    },
    {
      "from": "replica",
      "to": "primary",
      "label": "ack"
    },
    {
      "from": "primary",
      "to": "client",
      "label": "ok"
    },
    {
      "from": "client",
      "to": "primary",
      "label": "write x=2",
      "lost": true,
      "caption": "primary has crashed: the write is lost"
    },
    {
      "from": "client",
      "to": "replica",
      "label": "retry x=2",
      "caption": "client retries against the promoted replica"
    }
  ],
  "events": [
    {
      "after": "ok",
      "delay": 100,
      "node": "primary",
      "status": "down",
      "caption": "primary crashes"
    },
    {
      "after": "write x=2",
      "node": "replica",
      "status": "leader",
      "caption": "replica is promoted"
    }
  ]
}
