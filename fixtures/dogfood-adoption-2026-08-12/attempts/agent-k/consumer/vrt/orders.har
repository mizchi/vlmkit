nitial-scale=1\">\n<title>Orders</title>\n<link rel=\"stylesheet\" href=\"app.css\">\n</head>\n<body>\n<header class=\"bar\"><h1>Orders</h1><p class=\"who\">signed in as ops@example.com</p></header>\n<main>\n  <table class=\"orders\">\n    <thead><tr><th>Order</th><th>Customer</th><th>Total</th><th>State</th></tr></thead>\n    <tbody id=\"rows\"></tbody>\n  </table>\n  <p class=\"hint\">Totals exclude tax. FIXME confirm rounding with finance.</p>\n</main>\n<footer class=\"actions\">\n  <button class=\"btn btn--primary\" id=\"export\">Export CSV</button>\n  <button class=\"btn\" id=\"refund\">Refund</button>\n  <button class=\"btn\" id=\"archive\">Archive</button>\n</footer>\n<script>\n  fetch(\"/api/orders\").then((r) => r.json()).then((orders) => {\n    document.getElementById(\"rows\").innerHTML = orders.map((o) =>\n      `<tr><td>${o.id}</td><td>${o.customer}</td><td>${o.total}</td><td class=\"state\">${o.state}</td></tr>`\n    ).join(\"\");\n  });\n</script>\n</body>\n</html>\n"},"headersSize":171,"bodySize":1059,"redirectURL":"","_transferSize":1230},"cache":{},"timings":{"dns":0.067,"connect":1.151,"ssl":2.724,"send":0,"wait":11.434,"receive":2.742},"_resourceType":"document","serverIPAddress":"127.0.0.1","_serverPort":4321,"_securityDetails":{}},{"pageref":"page@54dc9ff638ef1dad6edbfa916a906d62","startedDateTime":"2026-08-13T13:00:01.528Z","time":4.62,"request":{"method":"GET","url":"http://localhost:4321/app.css","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"text/css,*/*;q=0.1"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Connection","value":"keep-alive"},{"name":"Host","value":"localhost:4321"},{"name":"Referer","value":"http://localhost:4321/"},{"name":"Sec-Fetch-Dest","value":"style"},{"name":"Sec-Fetch-Mode","value":"no-cors"},{"name":"Sec-Fetch-Site","value":"same-origin"},{"name":"User-Agent","value":"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/149.0.7827.5