/// vrt smoke tests, Pkl-typed mirror of `scripts/smoke-all-clis.sh`.
///
/// Each Test runs one markup-assistance CLI on its canonical fixture
/// and asserts exit 0. `specRef` links the test back to one or more
/// Scenario IDs from `Spec.pkl` so `pkspec check` can verify every
/// approved Scenario has an implementing test. The bash script
/// remains the single source of truth for fixture wiring; this file
/// adds the Pkl-typed gate.
///
/// Run:  pkspec exec -f Test.pkl
/// Gate: pkspec check Spec.pkl Test.pkl
amends "pkspec/Test.pkl"

local vrt = "node --experimental-strip-types src/cli/vrt.ts"
local outDir = "test-results/smoke-pkspec"

tests {
  // ── Build / fidelity ──────────────────────────────────────────
  new {
    name = "component-from-image"
    description = "Rebuild a card from a blank starter against a target PNG."
    specRef { "FIDELITY-001"; "SMOKE" }
    cmd = "\(vrt) component-from-image fixtures/wireframe/pricing-card/target-desktop.png fixtures/wireframe/pricing-card/blank.html --output-dir \(outDir)/component-from-image"
    expectStdoutContains { "vrt component-from-image"; "report:" }
    timeoutSec = 120
  }
  new {
    name = "component-from-image-typo"
    description = "Same CLI on a fixture with wrong-size/weight typography."
    specRef { "FIDELITY-001"; "SMOKE" }
    cmd = "\(vrt) component-from-image fixtures/typography/wrong-size-weight/target.png fixtures/typography/wrong-size-weight/buggy.html --output-dir \(outDir)/component-from-image-typo"
    expectStdoutContains { "vrt component-from-image"; "report:" }
    timeoutSec = 120
  }
  new {
    name = "component-extract"
    description = "Crop a single component from a page screenshot."
    specRef { "A8"; "SMOKE" }
    cmd = "\(vrt) component-extract fixtures/wireframe/pricing-card/target-desktop.png --crop 0 --output-dir \(outDir)/component-extract"
    expectStdoutContains { "vrt component-extract"; "report:" }
    timeoutSec = 60
  }

  // ── A11y ──────────────────────────────────────────────────────
  new {
    name = "a11y-contrast"
    description = "WCAG AA text contrast scan on low-contrast fixture."
    specRef { "F1"; "SMOKE" }
    cmd = "\(vrt) a11y-contrast fixtures/a11y-contrast/low-contrast/page.html --output-dir \(outDir)/a11y-contrast"
    expectStdoutContains { "vrt a11y-contrast"; "report:" }
    timeoutSec = 60
  }
  new {
    name = "a11y-touch"
    description = "Touch-target size scan, WCAG 2.5.5 and 2.5.8."
    specRef { "F2"; "SMOKE" }
    cmd = "\(vrt) a11y-touch fixtures/a11y-touch/small-targets/page.html --output-dir \(outDir)/a11y-touch"
    expectStdoutContains { "vrt a11y-touch"; "report:" }
    timeoutSec = 60
  }
  new {
    name = "a11y-focus-order"
    description = "Tab order matches visual reading order."
    specRef { "F3"; "SMOKE" }
    cmd = "\(vrt) a11y-focus-order fixtures/a11y-focus-order/reversed/page.html --output-dir \(outDir)/a11y-focus-order"
    expectStdoutContains { "vrt a11y-focus-order"; "report:" }
    timeoutSec = 60
  }

  // ── Design system ────────────────────────────────────────────
  new {
    name = "design-tokens"
    description = "Radius / spacing / z-index / shadow-tier conformance."
    specRef { "M1"; "M4-M6"; "SMOKE" }
    cmd = "\(vrt) design-tokens fixtures/design-tokens/off-scale/page.html --output-dir \(outDir)/design-tokens"
    expectStdoutContains { "vrt design-tokens"; "report:" }
    timeoutSec = 60
  }
  new {
    name = "component-consistency"
    description = "Inline-vs-component drift on a single page."
    specRef { "J2"; "SMOKE" }
    cmd = "\(vrt) component-consistency fixtures/component-consistency/inline-leak/page.html --selector .card --output-dir \(outDir)/component-consistency"
    expectStdoutContains { "vrt component-consistency"; "report:" }
    timeoutSec = 60
  }
  new {
    name = "multi-page-consistency"
    description = "Same selector across pages should render identically."
    specRef { "J2"; "SMOKE" }
    cmd = "\(vrt) multi-page-consistency --selector .footer --files fixtures/multi-page/footer-drift/about.html fixtures/multi-page/footer-drift/blog.html fixtures/multi-page/footer-drift/pricing.html --output-dir \(outDir)/multi-page-consistency"
    expectStdoutContains { "vrt multi-page-consistency"; "report:" }
    timeoutSec = 90
  }

  // ── Variant resilience ──────────────────────────────────────
  new {
    name = "theme-parity"
    description = "Dark-mode parity: every component responds to color-scheme."
    specRef { "C1"; "SMOKE" }
    cmd = "\(vrt) theme-parity fixtures/theme-parity/card-with-bug/buggy.html --output-dir \(outDir)/theme-parity"
    expectStdoutContains { "vrt theme-parity"; "report:" }
    timeoutSec = 60
  }
  new {
    name = "media-variants"
    description = "forced-colors / reduced-motion / print / RTL / zoom-200 sweep."
    specRef { "C2-C6"; "SMOKE" }
    cmd = "\(vrt) media-variants fixtures/media-variants/card/hostile.html --output-dir \(outDir)/media-variants"
    expectStdoutContains { "vrt media-variants"; "report:" }
    timeoutSec = 120
  }
  new {
    name = "cross-browser"
    description = "Chromium / Firefox / WebKit parity."
    specRef { "H1"; "SMOKE" }
    cmd = "\(vrt) cross-browser fixtures/wireframe/pricing-card/reference.html --allow-skipped --output-dir \(outDir)/cross-browser"
    expectStdoutContains { "vrt cross-browser"; "report:" }
    timeoutSec = 120
  }
  new {
    name = "i18n-stress"
    description = "1.4x word inflation should not overflow or wrap."
    specRef { "I1"; "SMOKE" }
    cmd = "\(vrt) i18n-stress fixtures/i18n-stress/button-overflow/page.html --output-dir \(outDir)/i18n-stress"
    expectStdoutContains { "vrt i18n-stress"; "report:" }
    timeoutSec = 60
  }
  new {
    name = "perf"
    description = "CLS detection via in-page PerformanceObserver."
    specRef { "K5"; "SMOKE" }
    cmd = "\(vrt) perf fixtures/perf/cls-bug/page.html --output-dir \(outDir)/perf"
    expectStdoutContains { "vrt perf"; "report:" }
    timeoutSec = 60
  }

  // ── Interaction ─────────────────────────────────────────────
  new {
    name = "interact"
    description = "Drive a click/type sequence and diff each transition."
    specRef { "O2"; "SMOKE" }
    cmd = "\(vrt) interact fixtures/interact/dropdown-form/page.html --sequence fixtures/interact/dropdown-form/sequence.json --output-dir \(outDir)/interact"
    expectStdoutContains { "vrt interact"; "report:" }
    timeoutSec = 90
  }
  new {
    name = "form-validation-diff"
    description = "Drive a signup form through invalid → valid states and diff each transition."
    specRef { "E5"; "SMOKE" }
    cmd = "\(vrt) interact fixtures/interact/form-validation/page.html --sequence fixtures/interact/form-validation/sequence.json --output-dir \(outDir)/form-validation-diff"
    expectStdoutContains { "vrt interact"; "report:" }
    timeoutSec = 90
  }

  // ── Agent ergonomics ────────────────────────────────────────
  new {
    name = "explore"
    description = "Page advertises actions via __vrtActions / data-vrt-action."
    specRef { "O1"; "SMOKE" }
    cmd = "\(vrt) explore fixtures/explore/declarative/page.html --output-dir \(outDir)/explore"
    expectStdoutContains { "vrt explore"; "report:" }
    timeoutSec = 60
  }
  new {
    name = "explore-strict-timing-silent-handler"
    description = "--strict-timing flags silent-handler / byte-identical-PNG case (#8)."
    specRef { "O1" }
    // The fixture wires a no-op click handler whose CSS reset
    // suppresses every focus indicator, so the before/after PNGs
    // are byte-identical. Without --strict-timing this would
    // report a misleading Δ 0.00% pass; with the flag it exits
    // non-zero and the report row reads "silent — 0 DOM mutations".
    cmd = "\(vrt) explore fixtures/explore/byte-identical-bug/silent-listener.html --output-dir \(outDir)/explore-strict-timing --strict-timing || true"
    expectStdoutContains { "silent handler"; "0 DOM mutations" }
    timeoutSec = 60
  }
  new {
    name = "interact-heal-all"
    description = "--heal-all probes the healer on every successful selector step (#11)."
    specRef { "O2" }
    // Fixture clicks `.btn-secondary`; the healer flags the sibling
    // `.btn-primary` (Save) as a "did you mean" candidate (~13%
    // confidence) so the report row surfaces the ambiguity even
    // though the step technically succeeded.
    cmd = "\(vrt) interact fixtures/interact/heal-all-demo/page.html --sequence fixtures/interact/heal-all-demo/sequence.json --output-dir \(outDir)/interact-heal-all --heal-all"
    // 13% confidence falls in the "weak" tier (10-30%); the 2026-05-15
    // dogfood reset the "did you mean" label to "weak match" at this
    // confidence band, so the assertion targets the candidate selector
    // plus the tier-summary string instead of the old wording.
    expectStdoutContains { "weak match"; "button.btn-primary"; "weak suggestion" }
    timeoutSec = 60
  }
  new {
    name = "skill-pricing-card"
    description = "Skill playbook fans out N checks over one target."
    specRef { "O3-O5"; "SMOKE" }
    cmd = "\(vrt) skill run pricing-card --against fixtures/wireframe/pricing-card/reference.html --output-dir \(outDir)"
    expectStdoutContains { "vrt skill run pricing-card"; "report:" }
    timeoutSec = 180
  }

  // ── Existing tools (smoke gate only) ────────────────────────
  new {
    name = "compare"
    description = "Migration compare (existing tool), shadcn fixture."
    specRef { "MIG-001"; "CORE-002"; "CORE-003"; "SMOKE" }
    cmd = "\(vrt) compare --dir fixtures/migration/shadcn-to-luna --baseline before.html --variants after-blank.html --output-dir \(outDir)/compare --no-paint-tree --no-discover"
    expectStdoutContains { "Migration VRT Compare"; "Report:" }
    timeoutSec = 60
  }
  new {
    name = "png-diff"
    description = "Existing PNG diff utility, identity check (0% diff)."
    specRef { "CORE-001"; "SMOKE" }
    cmd = "\(vrt) png-diff fixtures/wireframe/pricing-card/target-desktop.png fixtures/wireframe/pricing-card/target-desktop.png --output-dir \(outDir)/png-diff"
    expectStdoutContains { "PNG Diff"; "diff:" }
    timeoutSec = 30
  }
}
