{
  "name": "@mizchi/vlmkit",
  "version": "0.9.0",
  "description": "VLM-driven frontend toolkit: visual regression (snapshot / diff / regression-watch), markup synthesis from screenshots, design-token / theme / a11y / i18n audits, and a 2-stage VLM+LLM CSS auto-repair loop.",
  "license": "MIT",
  "author": "mizchi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mizchi/vlmkit.git"
  },
  "homepage": "https://github.com/mizchi/vlmkit#readme",
  "bugs": {
    "url": "https://github.com/mizchi/vlmkit/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "vlmkit": "./dist/vlmkit.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/client.d.mts",
      "import": "./dist/client.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "import": "./dist/client.mjs"
    },
    "./playwright": {
      "types": "./dist/playwright.d.mts",
      "import": "./dist/playwright.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**",
    "!dist/e2e/**",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "pnpm build:packages && pnpm moon:build:markup && tsdown",
    "build:packages": "pnpm --filter './packages/**' --filter '!@mizchi/vlmkit-mcp' --recursive run build",
    "prepack": "pnpm build",
    "pretest": "pnpm build:packages",
    "smoke:dist": "pnpm build && bash scripts/smoke-dist.sh",
    "smoke:dist:strict": "pnpm build && bash scripts/smoke-dist.sh --strict",
    "smoke:pack:markup-loop": "node scripts/smoke-packed-markup-loop.mjs",
    "smoke:pack:workspaces": "node scripts/smoke-packed-workspaces.mjs",
    "test": "node --test 'src/**/*.test.ts' 'packages/*/src/**/*.test.ts' 'worker/**/*.test.ts' 'examples/**/*.test.mjs'",
    "test:examples": "node --test 'examples/**/*.test.mjs'",
    "dogfood:markup-vrt:offline": "MARKUP_EVAL_OFFLINE=1 node examples/markup-vrt-eval/run.mjs",
    "demo": "node src/demo/demo.ts",
    "demo:fix": "node src/demo/demo-fix-loop.ts",
    "demo:multi": "node src/demo/demo-scenarios.ts",
    "demo:multistep": "node src/demo/demo-multistep.ts",
    "moon:test:markup": "moon -C packages/vlmkit-markup test markup-core && moon -C packages/vlmkit-markup check markup-core-api markup-core-cli",
    "moon:build:markup": "moon -C packages/vlmkit-markup build markup-core markup-core-api markup-core-cli --target js",
    "moon:test:game-assets": "moon -C design-runs/game-assets-20260520 test motion-core && moon -C design-runs/game-assets-20260520 test motion-core-cli-args && moon -C design-runs/game-assets-20260520 test motion-kagura-bridge && moon -C design-runs/game-assets-20260520 check motion-core-cli",
    "moon:build:game-assets": "moon -C design-runs/game-assets-20260520 build motion-core motion-core-cli-args motion-kagura-bridge motion-core-cli --target js",
    "moon:parity:game-assets": "node design-runs/game-assets-20260520/tools/check-motion-core-parity.mjs",
    "motion:policy-utils:game-assets": "node --test design-runs/game-assets-20260520/tools/motion-quality-gold-utils.test.mjs design-runs/game-assets-20260520/tools/retarget-profile-calibration-utils.test.mjs design-runs/game-assets-20260520/tools/motion-normalization-selection-utils.test.mjs design-runs/game-assets-20260520/tools/vrm-vrma-playback-contract-utils.test.mjs",
    "motion:retarget-profiles:game-assets": "node design-runs/game-assets-20260520/tools/check-retarget-profiles.mjs",
    "motion:retarget-calibration:game-assets": "node design-runs/game-assets-20260520/tools/check-retarget-profile-calibration.mjs",
    "motion:vrm-vrma-contract:game-assets": "node design-runs/game-assets-20260520/tools/verify-vrm-vrma-playback-contract.mjs --vrm design-runs/game-assets-20260520/models/robot-voxel-motion/robot-voxel-motion.glb --vrma design-runs/game-assets-20260520/models/robot-voxel-motion/derived/robot-voxel-motion.vrma-bridge.fixture.vrma --motion design-runs/game-assets-20260520/models/robot-voxel-motion/derived/robot-voxel-motion.fixture-vrma.extracted.motion.json --render-verify design-runs/game-assets-20260520/models/robot-voxel-motion/derived/robot-voxel-motion.fixture-vrma.roundtrip.render-verify.json --required-bones hips,head --required-clips vrma_alert_wave --allow-non-vrm-target",
    "motion:core-smoke:game-assets": "node design-runs/game-assets-20260520/tools/check-game-asset-motion-core.mjs",
    "motion:kagura-handoff:game-assets": "node design-runs/game-assets-20260520/tools/check-kagura-handoffs.mjs",
    "motion:kagura-runtime:game-assets": "node design-runs/game-assets-20260520/tools/check-kagura-runtime-smokes.mjs",
    "motion:kagura-runtime-calibrated:game-assets": "node design-runs/game-assets-20260520/tools/check-kagura-runtime-smokes.mjs --calibration-contract design-runs/game-assets-20260520/models/robot-voxel-motion/kagura-calibration-handoff.json",
    "motion:kagura-runtime-utils:game-assets": "node --test design-runs/game-assets-20260520/tools/game-asset-motion-core.test.mjs design-runs/game-assets-20260520/tools/kagura-runtime-smoke-utils.test.mjs design-runs/game-assets-20260520/tools/kagura-runtime-batch-utils.test.mjs",
    "vrt": "playwright test",
    "vrt:update": "playwright test --update-snapshots",
    "build:packages:js": "pnpm --filter './packages/**' --filter '!@mizchi/vlmkit-mcp' --filter '!@mizchi/vlmkit-markup' --recursive run build && pnpm --filter @mizchi/vlmkit-markup run build:js"
  },
  "devDependencies": {
    "@mizchi/vlmkit-ai": "workspace:*",
    "@mizchi/vlmkit-capture": "workspace:*",
    "@mizchi/vlmkit-core": "workspace:*",
    "@mizchi/vlmkit-generate": "workspace:*",
    "@mizchi/vlmkit-heal": "workspace:*",
    "@mizchi/vlmkit-markup": "workspace:*",
    "@mizchi/vlmkit-plan": "workspace:*",
    "@mizchi/vlmkit-mcp": "workspace:*",
    "@types/node": "^25.5.2",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.18.1",
    "three": "^0.184.0",
    "tsdown": "^0.21.7",
    "tsx": "^4.22.4",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.12",
    "@playwright/test": "^1.61.1",
    "cac": "^7.0.0",
    "hono": "^4.12.10",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "ws": "^8.20.0"
  }
}
