{
  "name": "@mizchi/vlmkit",
  "version": "0.6.0",
  "description": "VLM-driven frontend toolkit: visual regression (snapshot / diff / regression-watch), markup synthesis from screenshots, design-token / theme / a11y / i18n audits, and a 2-stage VLM+LLM CSS auto-repair loop.",
  "license": "MIT",
  "author": "mizchi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mizchi/vlmkit.git"
  },
  "homepage": "https://github.com/mizchi/vlmkit#readme",
  "bugs": {
    "url": "https://github.com/mizchi/vlmkit/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "vlmkit": "./dist/vlmkit.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/client.d.mts",
      "import": "./dist/client.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "import": "./dist/client.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**",
    "!dist/e2e/**",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm build",
    "smoke:dist": "pnpm build && bash scripts/smoke-dist.sh",
    "smoke:dist:strict": "pnpm build && bash scripts/smoke-dist.sh --strict",
    "test": "node --test 'src/**/*.test.ts' 'packages/*/src/**/*.test.ts' 'worker/**/*.test.ts'",
    "demo": "node src/demo/demo.ts",
    "demo:fix": "node src/demo/demo-fix-loop.ts",
    "demo:multi": "node src/demo/demo-scenarios.ts",
    "demo:multistep": "node src/demo/demo-multistep.ts",
    "moon:test:game-assets": "moon -C design-runs/game-assets-20260520 test motion-core && moon -C design-runs/game-assets-20260520 test motion-core-cli-args && moon -C design-runs/game-assets-20260520 check motion-core-cli",
    "moon:build:game-assets": "moon -C design-runs/game-assets-20260520 build motion-core motion-core-cli-args motion-core-cli --target js",
    "moon:parity:game-assets": "node design-runs/game-assets-20260520/tools/check-motion-core-parity.mjs",
    "vrt": "playwright test",
    "vrt:update": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.18.1",
    "three": "^0.184.0",
    "tsdown": "^0.21.7",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.12",
    "@mizchi/vlmkit-ai": "workspace:*",
    "@mizchi/vlmkit-capture": "workspace:*",
    "@mizchi/vlmkit-core": "workspace:*",
    "@mizchi/vlmkit-markup": "workspace:*",
    "@playwright/test": "^1.52.0",
    "cac": "^7.0.0",
    "hono": "^4.12.10",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.58.2",
    "pngjs": "^7.0.0",
    "ws": "^8.20.0"
  }
}
