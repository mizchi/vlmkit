{
  "name": "@mizchi/vrt",
  "version": "0.4.0",
  "description": "Visual Regression Testing harness: multi-viewport snapshot + diff + workflow CLI driven by VLM/LLM analysis.",
  "license": "MIT",
  "author": "mizchi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mizchi/vrt.git"
  },
  "homepage": "https://github.com/mizchi/vrt#readme",
  "bugs": {
    "url": "https://github.com/mizchi/vrt/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "vrt": "./dist/vrt.mjs"
  },
  "exports": {
    "./client": {
      "types": "./dist/client.d.mts",
      "import": "./dist/client.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm build",
    "test": "node --test 'src/**/*.test.ts' 'packages/*/src/**/*.test.ts'",
    "demo": "node src/demo/demo.ts",
    "demo:fix": "node src/demo/demo-fix-loop.ts",
    "demo:multi": "node src/demo/demo-scenarios.ts",
    "demo:multistep": "node src/demo/demo-multistep.ts",
    "vrt": "playwright test",
    "vrt:update": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.18.1",
    "tsdown": "^0.21.7",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.12",
    "@mizchi/vrt-ai": "workspace:*",
    "@mizchi/vrt-capture": "workspace:*",
    "@mizchi/vrt-core": "workspace:*",
    "@mizchi/vrt-markup": "workspace:*",
    "@playwright/test": "^1.52.0",
    "cac": "^7.0.0",
    "hono": "^4.12.10",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.58.2",
    "pngjs": "^7.0.0",
    "ws": "^8.20.0"
  }
}
