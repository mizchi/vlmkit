/// vrt project specifications.
///
/// Two layers of goals + scenarios:
///
///   1. **Markup-assistance** (5 goals / 18 scenarios) drawn from
///      `docs/reports/2026-05-13-scenario-matrix-v2.md`. Each
///      scenario maps to a smoke test in `Test.pkl` via `specRef`.
///
///   2. **Core toolkit** (6 goals / 25 scenarios) documenting every
///      shipped capability outside the markup-assistance loop —
///      pixel/style/a11y diff primitives, snapshot workflow,
///      migration / refactor verification, CSS-challenge benchmark,
///      AI-assisted fix loop, and the HTTP API surface. These
///      scenarios are gated by `implementedBy = "code"` + a
///      `implementedAt` pointer rather than a Test.pkl smoke, so
///      `pkspec check` confirms the source file exists without
///      mandating a bash-level mirror for every primitive.
///
/// Authoring conventions:
///   - Markup-assistance scenario IDs match the v2 matrix prefix
///     (A8, B1, C1, …) so the link back to the matrix doc stays obvious.
///   - Core-toolkit scenario IDs use domain prefixes: CORE-, SNAP-,
///     MIG-, BENCH-, AIFIX-, API-, WORKFLOW-.
///   - severity = critical for items the smoke gate must enforce;
///     major for supplementary verification; minor for nice-to-have.
///   - reviewStatus = approved on everything we ship; pkspec check
///     will fail loudly if any approved entry loses its impl pointer.
amends "pkspec/Spec.pkl"

goals {
  // ── Markup-assistance loop ────────────────────────────────────
  new {
    id = "GOAL-MARKUP-FIDELITY"
    name = "Agent rebuilds a component to match a target image"
    description = "Wireframe-mode loop: target PNG in, HTML out, iterate until pixel diff is low."
    priority = 90
    reviewStatus = "approved"
    rationale = #"""
      The wireframe-mode loop — take a target PNG, write HTML, iterate
      until pixel diff is low — is the highest-leverage scenario for an
      LLM markup agent. Fidelity tooling (component-from-image,
      component-extract, typography hints, bbox/heatmap signals)
      collapses what would otherwise be many manual rounds.
    """#
  }
  new {
    id = "GOAL-A11Y-COMPLIANCE"
    name = "Rendered page passes WCAG AA contrast / size / order checks"
    description = "Contrast, touch target, focus order against the rendered DOM."
    priority = 85
    reviewStatus = "approved"
    rationale = #"""
      Three independent checks (contrast, touch target, focus order)
      gate the page before ship. None require source-code analysis —
      every check works against the rendered output.
    """#
  }
  new {
    id = "GOAL-DESIGN-SYSTEM"
    name = "Rendered values conform to declared design scales"
    description = "Radius / spacing / z-index / shadow / color-token conformance vs configurable scales."
    priority = 70
    reviewStatus = "approved"
    rationale = #"""
      Border-radius / spacing / z-index / shadow-tier conformance is
      verified against a configurable scale. Catches "agent invented a
      new 7px radius" before it leaks into a token catalog.
    """#
  }
  new {
    id = "GOAL-VARIANT-RESILIENCE"
    name = "Page survives theme / print / RTL / zoom / i18n variants"
    description = "User-preference + locale + browser variant sweep, no manual matrix."
    priority = 80
    reviewStatus = "approved"
    rationale = #"""
      One command sweeps five user-preference variants (theme-parity,
      media-variants forced-colors / reduced-motion / print / rtl /
      zoom-200) plus i18n text-inflation, plus cross-browser parity.
    """#
  }
  new {
    id = "GOAL-AGENT-ERGONOMICS"
    name = "Toolkit surfaces what to do, not just what's wrong"
    description = "Findings include actionable hex / px / CSS suggestions; selector healing on failure."
    priority = 75
    reviewStatus = "approved"
    rationale = #"""
      Findings include hex / px / suggested CSS the agent can paste.
      Failures include healed-selector suggestions. Declarative
      discovery (vrt explore) lets the page advertise its own
      testable surface (WebMCP-shaped). Skill playbooks let one
      command run a target's full check suite.
    """#
  }

  // ── Core toolkit (predates the markup-assistance suite) ───────
  new {
    id = "GOAL-CORE-DIFF"
    name = "Reliable pixel / style / a11y diff primitives"
    description = "Pixelmatch + computed-style + a11y-tree diff; every other command sits on these."
    priority = 95
    reviewStatus = "approved"
    rationale = #"""
      Every higher-level command sits on top of three primitives:
      pixelmatch-based PNG diff with heatmap, computed-style diff
      (per-property, per-state), and a11y-tree diff. They have to
      be correct in isolation before any compound workflow can be
      trusted.
    """#
  }
  new {
    id = "GOAL-SNAPSHOT-WORKFLOW"
    name = "Multi-viewport snapshot baseline / approve loop"
    description = "Capture per-viewport snapshots, diff vs baseline, approve to promote."
    priority = 85
    reviewStatus = "approved"
    rationale = #"""
      `vrt snapshot` captures a URL across viewports, diffs against
      the committed baseline, and surfaces a flipbook + fix-prompt
      so an agent can act on the report. `vrt workflow` is the
      stateful sibling for component-graph driven verification.
    """#
  }
  new {
    id = "GOAL-MIGRATION-VERIFICATION"
    name = "Refactor / migration confidence across two pages"
    description = "before.html vs after.html sweep with multi-viewport pixel + paint-tree diff."
    priority = 80
    reviewStatus = "approved"
    rationale = #"""
      `vrt compare` was the original entry point — given two HTMLs
      or URLs (Tailwind → vanilla, shadcn → Luna, normalize.css →
      modern-normalize.css), it reports per-viewport pixel diff +
      paint-tree diff and an agent-friendly Markdown summary.
    """#
  }
  new {
    id = "GOAL-CSS-CHALLENGE"
    name = "Benchmark detection rate of CSS regressions"
    description = "Random property/selector deletion + detection backend evaluation, 96.7% last measured."
    priority = 60
    reviewStatus = "approved"
    rationale = #"""
      The CSS challenge bench deletes a single property or selector
      block at random and measures whether vrt detects the change.
      96.7% detection rate at last measurement (see
      docs/knowledge.md). The bench drives backend evaluation
      (pixelmatch / Crater BiDi / Prescanner) and feeds the
      `detection-report` aggregator.
    """#
  }
  new {
    id = "GOAL-AI-FIX-LOOP"
    name = "VLM + LLM driven CSS fix synthesis"
    description = "Two-stage pipeline: VLM extracts structured diff, LLM emits CSS patch, re-verify."
    priority = 70
    reviewStatus = "approved"
    rationale = #"""
      The 2-stage pipeline (VLM for structured diff extraction,
      LLM for CSS fix synthesis) closes the auto-repair loop:
      detect → analyse → patch → re-verify. `vlm-bench` keeps the
      model choice honest by tracking cost / latency / detection
      count across providers.
    """#
  }
  new {
    id = "GOAL-API"
    name = "HTTP API exposes the toolkit to non-CLI consumers"
    description = "Hono server + typed VrtClient for browser extension / editor plugin use."
    priority = 50
    reviewStatus = "approved"
    rationale = #"""
      `vrt api serve` exposes /compare, /compare-renderers, /reason,
      /smoke-test, /status. The TypeScript `VrtClient` covers the
      same surface for in-process callers. Lets a browser extension
      or editor plugin drive vrt without spawning Node per call.
    """#
  }
}

scenarios {
  // ╔═══════════════════════════════════════════════════════════════
  // ║  PART 1 — markup-assistance suite (smoke-test gated)
  // ╚═══════════════════════════════════════════════════════════════

  // ── Build / fidelity ──────────────────────────────────────────
  new {
    id = "A8"
    name = "Extract a single component from a page screenshot"
    severity = "major"
    reviewStatus = "approved"
    contributes { "GOAL-MARKUP-FIDELITY" }
    description = #"""
      Given a full-page PNG, `vrt component-extract` finds the major
      non-background components, classifies each (text / filled-rect /
      icon / image), and crops the chosen rank to a standalone PNG
      suitable for use as a target in `vrt component-from-image`.
    """#
  }
  new {
    id = "FIDELITY-001"
    name = "Build a card from a blank starter until diff under 3 percent"
    severity = "critical"
    reviewStatus = "approved"
    contributes { "GOAL-MARKUP-FIDELITY" }
    dependsOn { "CORE-001" }
    description = #"""
      `vrt component-from-image` against the pricing-card target
      reports bbox / heatmap / palette / typography signals; iteration
      converges the diff under 3% in <5 rounds on a representative
      fixture.
    """#
    decisions {
      new {
        date = "2026-05-13"
        summary = "Component-extract added so target PNGs can come from a full page"
        rationale = #"""
          Originally the wireframe loop required the user to crop the
          target by hand. Component-extract removed that step by
          finding non-background components, classifying each, and
          cropping a chosen rank.
        """#
      }
    }
  }

  // ── A11y ─────────────────────────────────────────────────────
  new {
    id = "F1"
    name = "WCAG AA text contrast scan"
    severity = "critical"
    reviewStatus = "approved"
    contributes { "GOAL-A11Y-COMPLIANCE" }
    description = "`vrt a11y-contrast` reports every text/background pair under the AA threshold, with the hex pair the agent can paste into a fix."
  }
  new {
    id = "F2"
    name = "Touch target size meets WCAG 2.5.5 AAA / 2.5.8 AA"
    severity = "critical"
    reviewStatus = "approved"
    contributes { "GOAL-A11Y-COMPLIANCE" }
    description = "`vrt a11y-touch` flags interactive elements below the 24px AA / 44px AAA minimum hit area."
  }
  new {
    id = "F3"
    name = "Tab order matches visual reading order"
    severity = "major"
    reviewStatus = "approved"
    contributes { "GOAL-A11Y-COMPLIANCE" }
    description = "`vrt a11y-focus-order` walks Tab traversal and compares against the bbox-sorted visual order."
  }

  // ── Design system ────────────────────────────────────────────
  new {
    id = "M1"
    name = "Color tokens conform to declared palette"
    severity = "major"
    reviewStatus = "approved"
    contributes { "GOAL-DESIGN-SYSTEM" }
    description = "`vrt design-tokens` flags rendered colors that fall outside the declared palette — catches off-scale hex values before they leak into the token catalog."
  }
  new {
    id = "M4-M6"
    name = "Radius / spacing / z-index / shadow-tier conformance"
    severity = "major"
    reviewStatus = "approved"
    contributes { "GOAL-DESIGN-SYSTEM" }
    description = "Same `design-tokens` CLI covers radius / spacing / z-index / shadow tiers via per-bucket configurable scales."
  }

  // ── Variant resilience ──────────────────────────────────────
  new {
    id = "C1"
    name = "Dark mode parity: every component responds to color-scheme"
    severity = "critical"
    reviewStatus = "approved"
    contributes { "GOAL-VARIANT-RESILIENCE" }
    description = "`vrt theme-parity` flips `prefers-color-scheme`, diffs every component, and surfaces ones that didn't update (forgot a `--var` or hard-coded a hex)."
  }
  new {
    id = "C2-C6"
    name = "Media variants: forced-colors / reduced-motion / print / RTL / zoom-200"
    severity = "major"
    reviewStatus = "approved"
    contributes { "GOAL-VARIANT-RESILIENCE" }
    description = "`vrt media-variants` sweeps the five hostile-user-preference media queries in one command and reports per-variant diffs."
  }
  new {
    id = "H1"
    name = "Cross-browser parity across Chromium / Firefox / WebKit"
    severity = "major"
    reviewStatus = "approved"
    contributes { "GOAL-VARIANT-RESILIENCE" }
    description = "`vrt cross-browser` renders the same HTML in all three engines and reports per-engine pixel diff against Chromium. `--allow-skipped` keeps CI green when WebKit isn't installed."
  }
  new {
    id = "I1"
    name = "i18n text inflation: no overflow or wrap at 1.4x word length"
    severity = "major"
    reviewStatus = "approved"
    contributes { "GOAL-VARIANT-RESILIENCE" }
    description = "`vrt i18n-stress` substitutes button / link text with 1.4× longer strings and flags overflow or wrap-to-second-line."
  }

  // ── Bug-finding / QA ────────────────────────────────────────
  new {
    id = "J2"
    name = "Inline-vs-component drift on a single page"
    severity = "major"
    reviewStatus = "approved"
    contributes { "GOAL-DESIGN-SYSTEM" }
    description = "`vrt component-consistency` screenshots every selector match on the page and diffs each against the reference — catches the still-inline call site after a botched extract-to-component refactor."
  }
  new {
    id = "K5"
    name = "CLS detection via in-page PerformanceObserver"
    severity = "major"
    reviewStatus = "approved"
    contributes { "GOAL-VARIANT-RESILIENCE" }
    description = "`vrt perf` wires up a PerformanceObserver inside the page and reports CLS / LCP / FCP without depending on Lighthouse."
  }

  // ── Interaction ─────────────────────────────────────────────
  new {
    id = "E5"
    name = "Form validation state diff from invalid to valid"
    severity = "major"
    reviewStatus = "approved"
    contributes { "GOAL-MARKUP-FIDELITY" }
    description = #"""
      `vrt interact` drives a form sequence through deliberate
      invalid → valid transitions (bad email, short password, then
      corrections) and pixel-diffs each transition so reviewers can
      see the validation-state visuals (red borders, error messages,
      enabled submit button) actually change as expected.
    """#
  }

  // ── Agent ergonomics ────────────────────────────────────────
  new {
    id = "O1"
    name = "Page declares actions via window.__vrtActions / data-vrt-action"
    severity = "major"
    reviewStatus = "approved"
    contributes { "GOAL-AGENT-ERGONOMICS" }
    description = #"""
      `vrt explore` auto-discovers actions the page advertises and
      diffs each transition. Shaped like the WebMCP proposal but
      doesn't depend on the unfinished spec.
    """#
  }
  new {
    id = "O2"
    name = "Selector miss in vrt interact triggers healer correction"
    severity = "major"
    reviewStatus = "approved"
    contributes { "GOAL-AGENT-ERGONOMICS" }
    description = "When a step selector fails to match, the healer scans the DOM for near-misses and prints `did you mean <selector>?` with confidence scores instead of a bare timeout."
  }
  new {
    id = "O3-O5"
    name = "Skill playbook fans out N checks over one target"
    severity = "major"
    reviewStatus = "approved"
    contributes { "GOAL-AGENT-ERGONOMICS" }
    description = "`vrt skill run <name> --against <html|url>` reads `.vrt-skills/<name>.json` and runs every check in the playbook against the target, aggregating into one report."
  }
  new {
    id = "SMOKE"
    name = "Mechanical smoke covers every markup-assistance CLI"
    severity = "critical"
    reviewStatus = "approved"
    contributes { "GOAL-AGENT-ERGONOMICS" }
    description = #"""
      `scripts/smoke-all-clis.sh` runs every markup-assistance CLI on
      its canonical fixture and asserts exit 0 + expected output. The
      pkspec Test.pkl mirror provides the same gate with the added
      Pkl-typed expectations.
    """#
    decisions {
      new {
        date = "2026-05-13"
        summary = "Pkl-typed Test.pkl added alongside the bash smoke script"
        rationale = #"""
          Bash script stays the single source of truth for fixture
          wiring; Test.pkl mirrors it so `pkspec check` can gate on
          specRef coverage without re-implementing fixture lookup.
        """#
      }
    }
  }

  // ╔═══════════════════════════════════════════════════════════════
  // ║  PART 2 — core toolkit (source-anchored via implementedAt)
  // ╚═══════════════════════════════════════════════════════════════

  // ── Core diff primitives ─────────────────────────────────────
  new {
    id = "CORE-001"
    name = "PNG pixel diff with heatmap overlay"
    severity = "critical"
    reviewStatus = "approved"
    contributes { "GOAL-CORE-DIFF" }
    implementedBy = "test"
    description = #"""
      `vrt png-diff <baseline> <current>` uses pixelmatch v7 plus a
      heatmap renderer to report per-region intensity. Smoke test
      `png-diff` in Test.pkl exercises the identity (0%) path.
    """#
  }
  new {
    id = "CORE-002"
    name = "Computed style diff across hover and focus states"
    severity = "major"
    reviewStatus = "approved"
    contributes { "GOAL-CORE-DIFF" }
    implementedBy = "code"
    implementedAt = "src/migration-compare.ts"
    description = #"""
      `getComputedStyle` capture for both rest and pseudo-states
      (`:hover`, `:focus`) plus per-property delta surfacing.
      Embedded inside `vrt compare` rather than exposed as its own
      CLI; the report.md groups deltas by selector + property.
    """#
  }
  new {
    id = "CORE-003"
    name = "A11y tree diff between two renders"
    severity = "major"
    reviewStatus = "approved"
    contributes { "GOAL-CORE-DIFF" }
    implementedBy = "code"
    implementedAt = "src/migration-compare.ts"
    description = #"""
      Capture Playwright's accessibility snapshot for each side of
      the compare and surface structural changes — role / name /
      level diffs that pure pixel diff misses.
    """#
  }
  new {
    id = "CORE-004"
    name = "Element-level shift-isolated diff"
    severity = "major"
    reviewStatus = "approved"
    contributes { "GOAL-CORE-DIFF" }
    implementedBy = "code"
    implementedAt = "src/element-compare.ts"
    description = #"""
      `vrt elements` diffs per-element bounding boxes after isolating
      cascading layout shift; useful when a single element moves and
      pixel diff would otherwise blame everything downstream.
    """#
  }
  new {
    id = "CORE-005"
    name = "Paint tree diff via Crater BiDi backend"
    severity = "minor"
    reviewStatus = "approved"
    contributes { "GOAL-CORE-DIFF"; "GOAL-MIGRATION-VERIFICATION" }
    implementedBy = "code"
    implementedAt = "src/migration-paint-tree.ts"
    description = #"""
      Optional Crater-backed paint-tree comparison; ~1.66x speedup
      vs pixelmatch on the dogfood corpus with 0% false positive.
      Off by default (`--no-paint-tree`).
    """#
  }

  // ── Snapshot workflow ────────────────────────────────────────
  new {
    id = "SNAP-001"
    name = "Multi-viewport snapshot baseline capture"
    severity = "critical"
    reviewStatus = "approved"
    contributes { "GOAL-SNAPSHOT-WORKFLOW" }
    implementedBy = "code"
    implementedAt = "src/snapshot.ts"
    description = #"""
      `vrt snapshot <url1> [url2]` captures every URL across the
      configured viewport set on first run; subsequent runs diff
      against the baseline. Masks via `--mask <selector,...>`
      exclude animated regions.
    """#
  }
  new {
    id = "SNAP-002"
    name = "Snapshot approve workflow promotes current to baseline"
    severity = "major"
    reviewStatus = "approved"
    contributes { "GOAL-SNAPSHOT-WORKFLOW" }
    dependsOn { "SNAP-001" }
    implementedBy = "code"
    implementedAt = "src/snapshot-approve.ts"
    description = #"""
      `vrt snapshot approve` renames every `*-current.png` to
      `*-baseline.png`. Used after an intentional UI change is
      reviewed.
    """#
  }
  new {
    id = "SNAP-003"
    name = "Snapshot fix-prompt generates subagent-ready Markdown"
    severity = "major"
    reviewStatus = "approved"
    contributes { "GOAL-SNAPSHOT-WORKFLOW"; "GOAL-AGENT-ERGONOMICS" }
    implementedBy = "code"
    implementedAt = "src/snapshot-fix-prompt.ts"
    description = #"""
      Reads `snapshot-report.json` and renders a worst-first task
      list suitable for piping into a subagent / inline LLM. Honors
      `--limit N` so the prompt stays focused.
    """#
  }
  new {
    id = "SNAP-004"
    name = "Snapshot stability measures false-positive rate"
    severity = "major"
    reviewStatus = "approved"
    contributes { "GOAL-SNAPSHOT-WORKFLOW" }
    implementedBy = "code"
    implementedAt = "src/snapshot-stability.ts"
    description = #"""
      `vrt snapshot stability` re-runs the same snapshot N times
      against a single URL and reports the per-frame diff. Drives
      the mask-coverage tuning loop for sites with carousels or
      counters.
    """#
  }
  new {
    id = "WORKFLOW-001"
    name = "Workflow init / capture / verify / approve loop"
    severity = "major"
    reviewStatus = "approved"
    contributes { "GOAL-SNAPSHOT-WORKFLOW" }
    implementedBy = "code"
    implementedAt = "src/vrt-command-router.ts:WORKFLOW_ALIAS_COMMANDS"
    description = #"""
      Stateful component-graph driven workflow: init writes
      baselines, capture takes current, verify diffs, approve
      promotes. Companion commands: `graph`, `affected`,
      `introspect`, `spec-verify`, `expect`.
    """#
  }

  // ── Migration / refactor verification ────────────────────────
  new {
    id = "MIG-001"
    name = "Migration compare across viewports"
    severity = "critical"
    reviewStatus = "approved"
    contributes { "GOAL-MIGRATION-VERIFICATION" }
    implementedBy = "test"
    description = #"""
      `vrt compare <before> <after>` (or `--dir + --baseline +
      --variants`) sweeps every viewport, emits report.md, .json
      and per-viewport heatmaps. Smoke-tested via the
      `compare` entry in Test.pkl.
    """#
  }
  new {
    id = "MIG-002"
    name = "Agent-friendly diff Markdown summary"
    severity = "major"
    reviewStatus = "approved"
    contributes { "GOAL-MIGRATION-VERIFICATION"; "GOAL-AGENT-ERGONOMICS" }
    implementedBy = "code"
    implementedAt = "src/diff-for-agent-cli.ts"
    description = #"""
      `vrt diff-for-agent <migration-report.json>` collapses a
      compare report into a worst-first table with selector +
      property aggregation. Default consumer is a subagent fix
      pass.
    """#
  }
  new {
    id = "MIG-003"
    name = "Reset CSS comparison: normalize vs modern-normalize vs destyle"
    severity = "minor"
    reviewStatus = "approved"
    contributes { "GOAL-MIGRATION-VERIFICATION" }
    implementedBy = "doc"
    implementedAt = "docs/reset-css-comparison.md"
    description = #"""
      Canonical fixture set (`fixtures/migration/reset-css`) +
      `pkf run migration-reset` task that diffs three reset CSSes
      against `no-reset.html`. Provides the domain reference for
      reset-CSS selection.
    """#
  }
  new {
    id = "MIG-004"
    name = "Compare-runs aggregates multiple VRT runs"
    severity = "minor"
    reviewStatus = "approved"
    contributes { "GOAL-MIGRATION-VERIFICATION"; "GOAL-AGENT-ERGONOMICS" }
    implementedBy = "code"
    implementedAt = "src/compare-runs-cli.ts"
    description = #"""
      `vrt compare-runs` diffs two prior vrt runs against each other
      (e.g. iter 0 vs iter 1 of a fix loop) so progress per round is
      visible at a glance.
    """#
  }

  // ── CSS challenge benchmark ─────────────────────────────────
  new {
    id = "BENCH-001"
    name = "CSS challenge bench delete-and-detect"
    severity = "major"
    reviewStatus = "approved"
    contributes { "GOAL-CSS-CHALLENGE" }
    implementedBy = "code"
    implementedAt = "src/css-challenge-bench.ts"
    description = #"""
      `vrt bench` (alias `pkf run css-bench`) randomly deletes a
      CSS property or selector block, runs the chosen detection
      backend, and accumulates a per-trial pass/fail record into
      `data/*.jsonl`.
    """#
  }
  new {
    id = "BENCH-002"
    name = "Detection report aggregates accumulated bench runs"
    severity = "minor"
    reviewStatus = "approved"
    contributes { "GOAL-CSS-CHALLENGE" }
    dependsOn { "BENCH-001" }
    implementedBy = "code"
    implementedAt = "src/detection-report.ts"
    description = #"""
      `vrt report` reads the jsonl history and emits per-fixture +
      per-backend detection-rate tables. Last measured: 96.7% on
      the canonical fixture set (docs/knowledge.md).
    """#
  }
  new {
    id = "BENCH-003"
    name = "Alternate bench backends: Crater BiDi and Prescanner"
    severity = "minor"
    reviewStatus = "approved"
    contributes { "GOAL-CSS-CHALLENGE" }
    implementedBy = "code"
    implementedAt = "src/css-challenge-bench.ts"
    description = #"""
      `--backend crater` and `--backend prescanner` route the bench
      through alternative renderers. Crater requires a running
      `crater bidi` server; Prescanner is in-process.
    """#
  }

  // ── AI-assisted fix loop ────────────────────────────────────
  new {
    id = "AIFIX-001"
    name = "VLM-extracted structured diff from before/after PNG"
    severity = "major"
    reviewStatus = "approved"
    contributes { "GOAL-AI-FIX-LOOP" }
    implementedBy = "code"
    implementedAt = "src/vrt-reasoning-pipeline.ts"
    description = #"""
      Stage 1 of the 2-stage pipeline: a vision-language model is
      shown the diff image and returns a structured list of
      CHANGE entries (selector + property + delta). Default
      VLM is meta-llama/llama-4-scout (docs/knowledge.md).
    """#
  }
  new {
    id = "AIFIX-002"
    name = "LLM-synthesised CSS patch from structured diff"
    severity = "major"
    reviewStatus = "approved"
    contributes { "GOAL-AI-FIX-LOOP" }
    dependsOn { "AIFIX-001"; "CORE-001" }
    implementedBy = "code"
    implementedAt = "src/fix-loop.ts"
    description = #"""
      Stage 2: the structured diff is fed to an LLM that returns a
      CSS patch; the patch is applied and re-verified against the
      target. Loop bails when diff < threshold or max-rounds hits.
    """#
  }
  new {
    id = "AIFIX-003"
    name = "VLM benchmarking: cost / latency / CHANGE count per model"
    severity = "minor"
    reviewStatus = "approved"
    contributes { "GOAL-AI-FIX-LOOP" }
    implementedBy = "code"
    implementedAt = "src/vlm-bench.ts"
    description = #"""
      `vrt vlm-bench` queries OpenRouter for candidate VLMs and
      runs each against the fix-loop hard case (seed 11). Outputs
      a Markdown comparison table used to choose the default model.
    """#
  }

  // ── HTTP API ────────────────────────────────────────────────
  new {
    id = "API-001"
    name = "HTTP API server exposes compare / reason / smoke endpoints"
    severity = "minor"
    reviewStatus = "approved"
    contributes { "GOAL-API" }
    implementedBy = "code"
    implementedAt = "src/api-server.ts"
    description = #"""
      `vrt api serve [--port N]` starts a Hono server with
      /api/compare, /api/compare-renderers, /api/reason,
      /api/smoke-test, /api/status. Lets a browser extension or
      editor plugin drive vrt without spawning a Node child.
    """#
  }
  new {
    id = "API-002"
    name = "TypeScript client mirrors the HTTP surface"
    severity = "minor"
    reviewStatus = "approved"
    contributes { "GOAL-API" }
    implementedBy = "code"
    implementedAt = "src/vrt-client.ts"
    description = #"""
      `VrtClient` in `src/vrt-client.ts` is the typed in-process
      client; one method per HTTP endpoint with shared input/output
      types from `src/api-types.ts`.
    """#
  }
}

